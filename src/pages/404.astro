---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面未找到。" noindex={true}>
  <div class="not-found blueprint">
    <div class="not-found__signal" aria-hidden="true"><span>4</span><b>0</b><span>4</span></div>
    <div class="not-found__copy">
      <p class="eyebrow"><b>ERR</b> / LOST IN THE INDEX</p>
      <h1>这一页没有留下坐标。</h1>
      <span>地址可能已经移动，也可能只是一次漂亮的拼写错误。</span>
      <nav aria-label="恢复导航">
        <a class="primary btn btn--primary" href="/">回到首页 <Icon name="arrow" size={17} /></a>
        <a class="btn" href="/search/"><Icon name="search" size={17} /> 搜索文章</a>
        <a class="btn" href="/posts/">浏览归档</a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    min-height: calc(100vh - var(--header-h) - 12rem);
    padding: clamp(3rem, 8vw, 5rem) var(--pad-x) clamp(4rem, 9vw, 6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--bg);
  }

  .not-found__signal {
    display: flex;
    align-items: center;
    color: transparent;
    font-family: var(--font-mono);
    font-size: clamp(7rem, 24vw, 16rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.8;
    white-space: nowrap;
    -webkit-text-stroke: 1px var(--line-strong);
  }

  .not-found__signal b {
    font-weight: inherit;
    -webkit-text-stroke: 1px var(--accent);
  }

  .not-found__copy {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    margin-top: clamp(-3rem, -4vw, -1.5rem);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border: 1px solid var(--line-strong);
    background: var(--bg);
    text-align: center;
  }

  .not-found__copy > p {
    margin-bottom: 1.1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .not-found__copy > span {
    margin-top: 1.1rem;
    display: block;
    color: var(--ink-2);
    font-size: 1rem;
  }

  nav {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  @media (max-width: 42rem) {
    nav { align-items: stretch; flex-direction: column; }
  }
</style>
