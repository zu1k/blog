---
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { signedWalletMessage, siteIdentity, wallets } from '../../data/identity';
import { SITE } from '../../consts';

const contacts = [
  { label: 'Email', value: 'i@zu1k.com', href: 'mailto:i@zu1k.com', icon: 'mail' },
  { label: 'GitHub', value: '@zu1k', href: 'https://github.com/zu1k', icon: 'github' },
  { label: 'Twitter', value: '@zu1k_', href: 'https://twitter.com/zu1k_', icon: 'twitter' },
  { label: 'Mastodon', value: '@zu1k@fosstodon.org', href: 'https://fosstodon.org/@zu1k', icon: 'mastodon' },
] as const;

const fingerprintGroups = siteIdentity.pgp.primaryFingerprintDisplay.split(' ');
const languages = ['Java', 'Python', 'C', 'Golang', 'Rust', 'JavaScript'];
const currentYear = new Date().getFullYear();
const localVerificationCommands = [
  `gpg --keyserver hkps://keyserver.ubuntu.com --recv-keys ${siteIdentity.pgp.primaryFingerprint}`,
  `gpg --fingerprint ${siteIdentity.pgp.primaryFingerprint}`,
  `curl -fL ${siteIdentity.url}/identity/zu1k-wallets.asc -o zu1k-wallets.asc`,
  'gpg --verify zu1k-wallets.asc',
].join('\n');
---
<BaseLayout title="关于" description="关于 zu1k、联系方式与公开身份信息。" type="profile">
  <div class="frame about-page">
    <header class="about-hero">
      <div class="about-hero__copy">
        <p class="about-eyebrow" data-no-select><b>PROFILE</b> / ABOUT</p>
        <h1 data-no-select>你好，<br />我是 <em>zu1k</em>。</h1>
        <p class="about-hero__lede">出生并生活在一个三面环海的小渔村。热爱开源，喜欢做一些玩具，也一直对外面的世界保持好奇。</p>
        <div class="about-paths">
          <a class="btn btn--primary" href="/projects/"><Icon name="arrow" size={15} /> 查看项目</a>
          <a class="btn" href="/rss.xml"><Icon name="rss" size={15} /> 订阅博客</a>
          <a class="btn btn--ghost" href="https://read.zu1k.com" rel="noopener" target="_blank">最近在读 <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <figure class="about-map">
        <svg viewBox="0 0 480 420" role="img" aria-label="示意地图：一座三面环海的半岛渔村，尖端有灯塔，海上有渔船">
          <defs>
            <pattern id="about-map-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" class="map-grid" /></pattern>
            <pattern id="about-map-waves" width="30" height="16" patternUnits="userSpaceOnUse"><path d="M3 9q4-4 8 0t8 0" fill="none" class="map-wave" /></pattern>
            <path id="about-coast" d="M120 420C128 360 96 318 132 262C162 214 150 160 200 128C238 104 250 70 292 78C336 86 350 128 334 170C318 212 344 236 362 272C382 312 360 352 392 420Z" />
          </defs>
          <rect width="480" height="420" class="map-sea" />
          <rect width="480" height="420" fill="url(#about-map-grid)" />
          <rect width="480" height="420" fill="url(#about-map-waves)" />

          <g class="map-depth">
            <use href="#about-coast" transform="translate(256 420) scale(1.16) translate(-256 -420)" />
            <use href="#about-coast" transform="translate(256 420) scale(1.34) translate(-256 -420)" />
          </g>

          <use href="#about-coast" class="map-land" />
          <g class="map-contour">
            <use href="#about-coast" transform="translate(262 360) scale(.8) translate(-262 -360)" />
            <use href="#about-coast" transform="translate(262 360) scale(.6) translate(-262 -360)" />
            <use href="#about-coast" transform="translate(262 360) scale(.4) translate(-262 -360)" />
          </g>

          <path d="M336 214H378M378 208V220" class="map-ink" fill="none" />

          <g class="map-house">
            <path transform="translate(284 190)" d="M0 7V1L4-3L8 1V7Z" />
            <path transform="translate(297 184)" d="M0 7V1L4-3L8 1V7Z" />
            <path transform="translate(310 196)" d="M0 7V1L4-3L8 1V7Z" />
            <path transform="translate(276 208)" d="M0 7V1L4-3L8 1V7Z" />
            <path transform="translate(302 214)" d="M0 7V1L4-3L8 1V7Z" />
            <path transform="translate(288 226)" d="M0 7V1L4-3L8 1V7Z" />
            <path transform="translate(316 230)" d="M0 7V1L4-3L8 1V7Z" />
          </g>

          <circle cx="296" cy="205" r="10" fill="none" class="map-accent-line" />
          <circle cx="296" cy="205" r="3" class="map-accent-fill" />
          <path d="M304 198L372 140H452" fill="none" class="map-accent-line" />
          <text x="376" y="133" class="map-label map-label--accent">HOME</text>
          <text x="376" y="156" class="map-label">小渔村 · 示意</text>

          <g transform="translate(272 100)">
            <path d="M-7-26L-22-38M7-26L22-38" class="map-accent-line" stroke-dasharray="2 3" />
            <path d="M-4 0L-2.5-18H2.5L4 0Z" class="map-house" />
            <rect x="-3.5" y="-24" width="7" height="6" class="map-accent-fill" />
            <path d="M-3.5-24L0-28L3.5-24" class="map-ink-fill" />
          </g>

          <path d="M415 250C400 236 392 226 380 216" fill="none" class="map-track" />
          <g transform="translate(424 258)">
            <path d="M-11 0H11L7 5H-7Z" class="map-ink-fill" />
            <path d="M0 0V-16" class="map-ink" />
            <path d="M1-15L9-2H1Z" class="map-sail-accent" />
          </g>
          <g transform="translate(70 196)">
            <path d="M-9 0H9L6 4H-6Z" class="map-ink-fill" />
            <path d="M0 0V-13" class="map-ink" />
            <path d="M-1-12L-8-2H-1Z" class="map-house" />
          </g>
          <path d="M78 202C96 214 108 228 116 246" fill="none" class="map-track" />

          <text x="30" y="300" class="map-label">W · 海</text>
          <text x="190" y="36" class="map-label">N · 海</text>
          <text x="410" y="340" class="map-label">E · 海</text>

          <g transform="translate(440 44)">
            <circle r="15" class="map-compass" />
            <path d="M0-10L5 6L0 2L-5 6Z" class="map-ink-fill" />
            <text y="-20" text-anchor="middle" class="map-label">N</text>
          </g>

          <g transform="translate(24 396)">
            <rect width="30" height="5" class="map-ink-fill" />
            <rect x="30" width="30" height="5" class="map-compass" />
            <rect x="60" width="30" height="5" class="map-ink-fill" />
            <text y="-6" class="map-label">0</text>
            <text x="90" y="-6" text-anchor="end" class="map-label">NOT TO SCALE</text>
          </g>
        </svg>
        <figcaption><span>FIG. 01 — 出生地</span><span>三面环海</span></figcaption>
      </figure>
    </header>

    <dl class="about-spec">
      <div class="about-spec__who">
        <img src="/images/logo.jpg" alt="zu1k" width="144" height="144" />
        <div><dt>Handle</dt><dd>zu1k</dd></div>
      </div>
      <div><dt>Role</dt><dd>Developer · Maker · Traveler</dd></div>
      <div><dt>Default lang</dt><dd class="mono">Rust</dd></div>
      <div><dt>Online since</dt><dd class="mono">{SITE.since} — {currentYear}</dd></div>
    </dl>

    <section class="section x-rule about-story" aria-labelledby="about-story-title">
      <div class="section__rail"><p class="rail-label eyebrow"><span class="index-no">01</span><span>The short version</span></p></div>
      <div class="section__body">
        <h2 id="about-story-title">关于我</h2>
        <div class="about-story__copy">
          <p>欢迎访问我的博客。这里主要分享一些经验、想法和作品：可能是一场持续两天的系统排查，也可能是一件刚好让生活变得更顺手的小工具。</p>
          <p>我从大学开始接触编程，先后使用 Java、Python、C、Golang、Rust 和 JavaScript。现在的新个人项目通常首选 Rust，但比语言本身更重要的，是把真实问题转化成可以使用、可以分享的东西。</p>
        </div>
        <ol class="language-trail" aria-label="使用过的编程语言，按接触先后排列">
          {languages.map((language, index) => (
            <li class:list={{ 'is-current': language === 'Rust' }}>
              <span>{String(index + 1).padStart(2, '0')}</span>{language}
            </li>
          ))}
        </ol>
        <p class="language-trail__note">// 按接触先后排列 · 高亮为当前首选</p>

        <dl class="about-values">
          <div>
            <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="7" cy="6" r="2.5" /><circle cx="7" cy="22" r="2.5" /><circle cx="21" cy="10" r="2.5" /><path d="M7 8.5v11M21 12.5c0 5-6 4-12.5 8" /></svg>
            <dt>OPEN SOURCE</dt><dd>让想法能够被检查、复用和继续生长。</dd>
          </div>
          <div>
            <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="7.5" /><path d="M17.5 17.5L24 24" /><path d="M9.5 10a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .8-1 1.5" /><circle cx="12" cy="16.5" r=".6" fill="currentColor" /></svg>
            <dt>CURIOSITY</dt><dd>对系统为什么这样运作，始终多问一个问题。</dd>
          </div>
          <div>
            <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3.5" y="5.5" width="21" height="17" /><path d="M3.5 10.5h21M8 5.5v5M12 15h8M12 18.5h5M7 15h1.5M7 18.5h1.5" /></svg>
            <dt>LONG WEB</dt><dd>认真维护一块属于自己的互联网空间。</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section x-rule contact-section" aria-labelledby="contact-title">
      <div class="section__rail"><p class="rail-label eyebrow"><span class="index-no">02</span><span>Contact / Say hello</span></p></div>
      <div class="section__body">
        <h2 id="contact-title">保持联系</h2>
        <p class="section-sub">博文相关问题优先留在评论区，这样答案也能帮助后来的人。</p>
        <div class="contact-grid">
          {contacts.map((contact, index) => (
            <a href={contact.href} rel="me noopener" target={contact.href.startsWith('http') ? '_blank' : undefined}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <Icon name={contact.icon} size={18} />
              <div><strong>{contact.label}</strong><small>{contact.value}</small></div>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section x-rule identity-section" aria-labelledby="identity-title">
      <div class="section__rail"><p class="rail-label eyebrow"><span class="index-no">03</span><span>Public identity</span></p></div>
      <div class="section__body">
        <h2 id="identity-title">PGP 公钥</h2>
        <p class="section-sub">需要验证我的身份或发送加密邮件时，可以使用这枚指纹。</p>
        <div class="fingerprint">
          <code aria-label={`主密钥指纹 ${siteIdentity.pgp.primaryFingerprintDisplay}`}>
            {fingerprintGroups.map((group) => <span>{group}</span>)}
          </code>
          <div class="fingerprint__bar">
            <span class="eyebrow">Primary key fingerprint</span>
            <button type="button" class="btn" data-copy-value={siteIdentity.pgp.primaryFingerprintDisplay}>复制指纹</button>
            <nav aria-label="PGP 公钥地址">
              <a class="btn btn--ghost" href={siteIdentity.pgp.publicKeyUrl} target="_blank" rel="noopener">pgp.zu1k.com ↗</a>
              <a class="btn btn--ghost" href={`https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${siteIdentity.pgp.primaryFingerprint}`} target="_blank" rel="noopener">Ubuntu Keyserver ↗</a>
            </nav>
          </div>
        </div>
      </div>
    </section>

    <section class="section x-rule support-section" aria-labelledby="support-title">
      <div class="section__rail"><p class="rail-label eyebrow"><span class="index-no">04</span><span>Support the work</span></p></div>
      <div class="section__body">
        <h2 id="support-title">支持公开创作</h2>
        <p class="section-sub">如果这些内容或工具对你有帮助，可以通过赞助支持后续维护。</p>
        <div class="wallet-list">
          {wallets.map((wallet) => (
            <div>
              <strong>{wallet.label}</strong>
              <code>{wallet.value}</code>
              <button type="button" class="btn btn--ghost" data-copy-value={wallet.value}>复制</button>
            </div>
          ))}
        </div>
        <p class="support-warning"><strong>VERIFY BEFORE TRANSFER</strong> 转账前请验证 PGP 签名；不要信任来自其他渠道的临时替换地址。</p>

        <details class="signature-proof">
          <summary>
            <span>
              <small>PGP / SHA-256</small>
              <strong>检查钱包地址签名</strong>
            </span>
            <span class="signature-proof__summary-action"><b>完整证明</b><i aria-hidden="true"></i></span>
          </summary>

          <div class="signature-proof__body">
            <div class="signature-proof__guide">
              <div>
                <p>下面保留了完整的 PGP 签名原文。浏览器验签会确认内容没有被改动，但你仍应从可信渠道独立核对主密钥指纹。</p>
                <div class="signature-proof__actions">
                  <button type="button" class="btn btn--primary" data-verify-signature>在浏览器中验签</button>
                  <a class="btn" href="/identity/zu1k-wallets.asc" download>下载签名文件</a>
                  <a class="btn btn--ghost" href="/identity/zu1k-public-key.asc" download>下载公钥</a>
                </div>
                <p class="verification-result" data-verification-result data-state="idle" aria-live="polite">
                  <span aria-hidden="true"></span>尚未在本次浏览器会话中验签
                </p>
              </div>
              <dl>
                <div>
                  <dt>主密钥指纹</dt>
                  <dd>{siteIdentity.pgp.primaryFingerprintDisplay}</dd>
                </div>
                <div>
                  <dt>签名子密钥</dt>
                  <dd>{siteIdentity.pgp.signingSubkeyFingerprintDisplay}</dd>
                </div>
              </dl>
            </div>

            <div class="signed-record">
              <header>
                <span>SIGNED CONTENT</span>
                <button type="button" class="btn btn--ghost" data-copy-target="#signed-wallet-message">复制原文</button>
              </header>
              <pre id="signed-wallet-message"><code>{signedWalletMessage}</code></pre>
            </div>
          </div>
        </details>

        <div class="local-verification">
          <header>
            <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
            <span>LOCAL VERIFICATION — zsh</span>
            <button type="button" data-copy-value={localVerificationCommands}>复制命令</button>
          </header>
          <pre><code>{localVerificationCommands.split('\n').map((command) => <span class="cmd">{command}</span>)}<span class="cursor" aria-hidden="true">▍</span></code></pre>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-value], [data-copy-target]').forEach((button) => {
    button.addEventListener('click', async () => {
      const original = button.textContent ?? '复制';
      try {
        const target = button.dataset.copyTarget
          ? document.querySelector<HTMLElement>(button.dataset.copyTarget)
          : null;
        const value = button.dataset.copyValue ?? target?.textContent ?? '';
        await navigator.clipboard.writeText(value);
        button.textContent = '已复制';
      } catch {
        button.textContent = '复制失败';
      }
      setTimeout(() => { button.textContent = original; }, 1600);
    });
  });

  const verifyButton = document.querySelector<HTMLButtonElement>('[data-verify-signature]');
  const verificationResult = document.querySelector<HTMLElement>('[data-verification-result]');

  const setVerificationResult = (state: 'loading' | 'valid' | 'invalid', message: string) => {
    if (!verificationResult) return;
    const statusDot = document.createElement('span');
    statusDot.setAttribute('aria-hidden', 'true');
    verificationResult.dataset.state = state;
    verificationResult.replaceChildren(statusDot, document.createTextNode(message));
  };

  verifyButton?.addEventListener('click', async () => {
    if (!verificationResult) return;

    verifyButton.disabled = true;
    verifyButton.textContent = '正在验签…';
    setVerificationResult('loading', '正在载入验证器并检查签名…');

    try {
      const [openpgp, signedResponse, publicKeyResponse] = await Promise.all([
        import('openpgp'),
        fetch('/identity/zu1k-wallets.asc'),
        fetch('/identity/zu1k-public-key.asc'),
      ]);

      if (!signedResponse.ok || !publicKeyResponse.ok) {
        throw new Error('Identity files could not be loaded.');
      }

      const [cleartextMessage, verificationKey] = await Promise.all([
        openpgp.readCleartextMessage({ cleartextMessage: await signedResponse.text() }),
        openpgp.readKey({ armoredKey: await publicKeyResponse.text() }),
      ]);
      const result = await openpgp.verify({ message: cleartextMessage, verificationKeys: verificationKey });

      if (result.signatures.length === 0) throw new Error('No signature found.');
      await Promise.all(result.signatures.map((signature) => signature.verified));

      const keyId = result.signatures[0]?.keyID?.toHex().toUpperCase();
      setVerificationResult('valid', `签名有效${keyId ? ` · 子密钥 ${keyId}` : ''}`);
      verifyButton.textContent = '重新验签';
    } catch {
      setVerificationResult('invalid', '验签失败，请下载文件后使用 GPG 再次检查');
      verifyButton.textContent = '重试验签';
    } finally {
      verifyButton.disabled = false;
    }
  });
</script>
<style>
  .about-page {
    --map-sea: color-mix(in srgb, var(--accent) 5%, var(--panel));
    --map-wave: color-mix(in srgb, var(--accent) 16%, var(--line));
    --map-land: color-mix(in srgb, #c8a668 16%, var(--bg));
    --map-contour: color-mix(in srgb, #a88b55 30%, var(--line));
  }

  /* Hero ------------------------------------------------------------------ */

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .about-hero__copy {
    min-width: 0;
    padding: clamp(2.6rem, 6vw, 4.2rem) var(--pad) 2.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-eyebrow {
    margin: 0 0 1.1rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
  }

  .about-eyebrow b {
    color: var(--accent);
    font-weight: 500;
  }

  .about-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .about-hero h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .about-hero__lede {
    max-width: 28rem;
    margin: 1.3rem 0 0;
    color: var(--ink-2);
    font-size: 0.82rem;
    line-height: 1.85;
  }

  .about-paths {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .about-map {
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
    background: var(--map-sea);
  }

  .about-map svg {
    width: 100%;
    height: auto;
    flex: 1;
    display: block;
  }

  .about-map figcaption {
    padding: 0.5rem 0.85rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    background: var(--bg);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }

  .map-sea { fill: var(--map-sea); }
  .map-grid { stroke: var(--grid); stroke-width: 1; }
  .map-wave { stroke: var(--map-wave); stroke-width: 1; }
  .map-depth { fill: none; stroke: var(--map-wave); stroke-width: 1; stroke-dasharray: 3 5; }
  .map-land { fill: var(--map-land); stroke: var(--ink); stroke-width: 1.4; }
  .map-contour { fill: none; stroke: var(--map-contour); stroke-width: 1; }
  .map-ink { stroke: var(--ink); stroke-width: 1.4; }
  .map-ink-fill { fill: var(--ink); }
  .map-house { fill: var(--paper); stroke: var(--ink); stroke-width: 1; }
  .map-accent-line { stroke: var(--accent); stroke-width: 1; }
  .map-accent-fill { fill: var(--accent); }
  .map-sail-accent { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1; }
  .map-track { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 2 4; }
  .map-compass { fill: var(--bg); stroke: var(--ink-3); stroke-width: 1; }

  .map-label {
    fill: var(--ink-3);
    font-family: var(--font-code);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .map-label--accent { fill: var(--accent); }

  /* Spec strip ------------------------------------------------------------ */

  .about-spec {
    margin: 0;
    display: grid;
    grid-template-columns: 1.15fr 1.2fr 0.9fr 1fr;
    border-top: 1px solid var(--line);
  }

  .about-spec > div {
    min-width: 0;
    padding: 0.85rem var(--pad);
    border-right: 1px solid var(--line);
  }

  .about-spec > div:last-child { border-right: 0; }

  .about-spec__who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .about-spec__who img {
    width: 2.2rem;
    height: 2.2rem;
    flex: none;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  .about-spec dt {
    color: var(--ink-3);
    font-family: var(--font-code);
