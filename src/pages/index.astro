---
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories, getPublishedPosts } from '../lib/content';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
const categoryCount = getCategories(posts).length;
---

<BaseLayout title="zu1k">
  <Fragment slot="head">
    <link rel="preload" href="/images/logo.jpg" as="image" fetchpriority="high" />
  </Fragment>
  <div class="modern-home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="home-kicker eyebrow" data-no-select><b>00</b> / PERSONAL LOG · SINCE 2017</p>
        <h1 id="home-title" data-no-select><span>zu1k</span><em>A boy dreaming of traveling around the world.</em></h1>
        <p class="home-intro">写代码，做工具，也记录那些无法被代码解释的生活。这里是关于安全、系统、开源与世界的个人索引。</p>
        <div class="home-actions" data-no-select>
          <a class="home-action home-action--primary btn btn--primary" href="/posts/" data-astro-prefetch="viewport">开始阅读 <Icon name="arrow" size={17} /></a>
          <a class="home-action btn" href="/projects/" data-astro-prefetch="viewport">查看项目</a>
        </div>
        <nav class="social-links" aria-label="社交链接" data-no-select>
          <a href="https://github.com/zu1k" rel="me noopener" aria-label="GitHub" title="GitHub"><Icon name="github" size={18} /></a>
          <a href="https://twitter.com/zu1k_" rel="me noopener" aria-label="Twitter" title="Twitter"><Icon name="twitter" size={17} /></a>
          <a href="https://t.me/peekfun" rel="me noopener" aria-label="Telegram" title="Telegram"><Icon name="telegram" size={17} /></a>
          <a href="https://fosstodon.org/@zu1k" rel="me noopener" aria-label="Mastodon" title="Mastodon"><Icon name="mastodon" size={17} /></a>
          <a href="mailto:i@zu1k.com" aria-label="Email" title="Email"><Icon name="mail" size={18} /></a>
        </nav>
      </div>

      <div class="home-portrait blueprint" data-no-select>
        <a href="/about/" aria-label="了解 zu1k" data-astro-prefetch="hover">
          <img src="/images/logo.jpg" alt="zu1k" width="320" height="320" loading="eager" decoding="async" fetchpriority="high" />
          <span>ABOUT ↗</span>
        </a>
        <p class="home-portrait__caption" aria-hidden="true"><span>FIG. 01</span><span>ZU1K / 2017—NOW</span></p>
      </div>

      <dl class="home-stats cells band" aria-label="博客概览" data-no-select>
        <div><dt>文章</dt><dd>{posts.length}</dd></div>
        <div><dt>主题</dt><dd>{categoryCount}</dd></div>
        <div><dt>写作</dt><dd>9<small>年</small></dd></div>
      </dl>
    </section>

    <section class="latest-writing band" aria-labelledby="latest-title">
      <header>
        <div>
          <p class="home-kicker eyebrow" data-no-select><b>01</b> / LATEST POSTS</p>
          <h2 id="latest-title">最近写下的</h2>
        </div>
        <a class="btn" href="/posts/" data-no-select data-astro-prefetch="hover">全部 {posts.length} 篇 <Icon name="arrow" size={16} /></a>
      </header>
      <div class="latest-writing__list cells cells--open">
        {latestPosts.map((post, index) => <PostCard post={post} variant="summary" index={index + 1} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .modern-home {
    width: 100%;
  }

  .home-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 24rem);
  }

  .home-hero__copy {
    min-width: 0;
    padding: clamp(3.5rem, 8vw, 6.5rem) var(--pad-x) clamp(2.75rem, 5vw, 4rem);
  }

  .home-kicker {
    margin-bottom: 1.6rem;
  }

  .home-hero h1 {
    margin: 0;
    line-height: 1;
  }

  .home-hero h1 span {
    display: block;
    font-size: clamp(4.5rem, 10vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .home-hero h1 em {
    max-width: 17ch;
    margin-top: 1rem;
    display: block;
    color: var(--ink-2);
    font-size: clamp(1.7rem, 3.4vw, 2.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .home-intro {
    max-width: 36rem;
    margin: 1.6rem 0 0;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .home-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .social-links {
    width: max-content;
    margin-top: 1.5rem;
    display: flex;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  .social-links a {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    color: var(--ink-2);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .social-links a + a {
    border-left: 1px solid var(--line-strong);
  }

  .social-links a:hover {
    color: var(--bg);
    background: var(--ink);
  }

  .home-portrait {
    position: relative;
    min-width: 0;
    padding: 3.5rem var(--pad-x) var(--pad-x);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    border-left: 1px solid var(--line);
  }

  .home-portrait::before,
  .home-portrait::after {
    position: absolute;
    z-index: 3;
    left: -5px;
    width: 9px;
    height: 9px;
    content: "";
    background:
      linear-gradient(var(--mark), var(--mark)) center / 1px 100% no-repeat,
      linear-gradient(var(--mark), var(--mark)) center / 100% 1px no-repeat;
    pointer-events: none;
  }

  .home-portrait::before { top: -5px; }
  .home-portrait::after { bottom: -5px; }

  .home-portrait a {
    position: relative;
    width: clamp(11rem, 19vw, 15rem);
    display: block;
    padding: 0.5rem;
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .home-portrait img {
    width: 100%;
    aspect-ratio: 1;
    display: block;
    object-fit: cover;
    transition: filter 0.3s ease;
  }

  .home-portrait a:hover img {
    filter: contrast(1.06);
  }

  .home-portrait a span {
    position: absolute;
    right: -1px;
    bottom: -1px;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .home-portrait a:hover span {
    border-color: var(--ink);
    color: var(--bg);
    background: var(--ink);
  }

  .home-portrait__caption {
    width: clamp(11rem, 19vw, 15rem);
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }

  .home-stats {
    grid-column: 1 / -1;
    margin: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .home-stats div {
    padding: 1rem var(--pad-x) 1.1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .home-stats dt {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .home-stats dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
  }

  .home-stats small {
    margin-left: 0.2rem;
    color: var(--ink-3);
    font-size: 0.75rem;
  }

  .latest-writing > header {
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--pad-x) 2rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .latest-writing .home-kicker {
    margin-bottom: 0.9rem;
  }

  .latest-writing h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .latest-writing__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 60rem) {
    .latest-writing__list {
      grid-template-columns: 1fr;
    }

    .latest-writing__list > :global(.post-summary.has-image),
    .latest-writing__list > :global(.post-summary) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.6fr);
    }

    .latest-writing__list :global(.post-summary__image) {
      order: 0;
      height: 100%;
      aspect-ratio: auto;
      border-bottom: 0;
      border-left: 1px solid var(--line);
    }
  }

  @media (max-width: 48rem) {
    .home-hero {
      grid-template-columns: 1fr;
    }

    .home-hero__copy {
      padding-top: 3.25rem;
    }

    .home-kicker {
      white-space: nowrap;
    }

    .home-hero h1 span { font-size: clamp(4rem, 21vw, 5.5rem); }
    .home-hero h1 em {
      font-size: clamp(1.55rem, 7.4vw, 2.1rem);
    }

    .home-portrait {
      padding: 1.25rem var(--pad-x);
      flex-direction: row;
      justify-content: flex-start;
      align-items: flex-end;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .home-portrait::before,
    .home-portrait::after {
      top: -5px;
      bottom: auto;
    }

    .home-portrait::after {
      right: -5px;
      left: auto;
    }

    .home-portrait a {
      width: 7.5rem;
      padding: 0.35rem;
    }

    .home-portrait a span {
      padding: 0.2rem 0.4rem;
      font-size: 0.5625rem;
    }

    .home-portrait__caption {
      width: auto;
      flex-direction: column;
    }

    .home-stats div {
      padding: 0.85rem 1rem;
      display: block;
    }

    .home-stats dd {
      margin-top: 0.4rem;
      font-size: 1.5rem;
    }

    .latest-writing > header {
      align-items: flex-start;
      flex-direction: column;
    }

    .latest-writing__list > :global(.post-summary.has-image),
    .latest-writing__list > :global(.post-summary) {
      display: flex;
    }

    .latest-writing__list :global(.post-summary__image) {
      order: -1;
      height: auto;
      aspect-ratio: 16 / 10;
      border-bottom: 1px solid var(--line);
      border-left: 0;
    }

    .latest-writing__list :global(.post-summary__image--blank) {
      display: none;
    }
  }
</style>
