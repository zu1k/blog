---
import Icon from './Icon.astro';
import { formatDate, getPostSlug, getPostUrl, getTaxonomyLabel, getTaxonomyUrl, toDate } from '../lib/content';

type PostData = {
  title: string;
  slug?: string;
  description?: string;
  summary?: string;
  date?: Date | string;
  tags?: string[];
  categories?: string[];
  resources?: Array<Record<string, unknown>>;
};

type PostLike = (PostData | { data: PostData }) & {
  id?: string;
  slug?: string;
  href?: string;
  url?: string;
};

export interface Props {
  post: PostLike;
  variant?: 'summary' | 'archive';
  index?: number;
}

const { post, variant = 'archive', index } = Astro.props;
const data: PostData = (post as { data?: PostData }).data ?? (post as PostData);
const slug = data.slug ?? post.slug ?? post.id ?? '';
const href = post.href ?? post.url ?? getPostUrl(slug);
const description = data.summary ?? data.description;
const date = data.date ? toDate(data.date) : undefined;
const dateText = date && !Number.isNaN(date.valueOf()) ? formatDate(date, 'short') : undefined;
const shortDate = dateText?.slice(5);
const isoDate = date && !Number.isNaN(date.valueOf()) ? date.toISOString() : undefined;
const categories = data.categories ?? [];
const tags = data.tags ?? [];
const featured = data.resources?.find((resource) => resource.name === 'featured-image');
const featuredSrc = typeof featured?.src === 'string' ? featured.src : undefined;
const imageModules = import.meta.glob('../content/posts/**/*.{png,jpg,jpeg,webp,gif}', { eager: true });
const imageKey = featuredSrc ? `../content/posts/${getPostSlug(slug)}/${featuredSrc}` : undefined;
const imageModule = imageKey ? imageModules[imageKey] as { default?: { src?: string; width?: number; height?: number } } | undefined : undefined;
const image = imageModule?.default;
---

{variant === 'summary' ? (
  <article class:list={['post-summary', { 'has-image': image?.src }]}>
    <div class="post-summary__copy">
      <div class="post-summary__topline">
        <span>{index ? String(index).padStart(2, '0') : 'NEW'}</span>
        {dateText && <time datetime={isoDate}>{dateText}</time>}
      </div>
      <h2><a href={href} data-astro-prefetch="hover">{data.title}</a></h2>
      <div class="post-summary__meta">
        {categories[0] && (
          <a href={getTaxonomyUrl('categories', categories[0])}>
            <Icon name="folder" size={13} /> {getTaxonomyLabel('categories', categories[0])}
          </a>
        )}
        <span>BY ZU1K</span>
      </div>
      {description && <p>{description}</p>}
      <footer>
        <a class="read-more" href={href} data-astro-prefetch="hover">阅读全文 <Icon name="arrow" size={15} /></a>
        {tags.length > 0 && (
          <div class="post-summary__tags" aria-label="标签">
            {tags.slice(0, 3).map((tag) => <a href={getTaxonomyUrl('tags', tag)}>#{getTaxonomyLabel('tags', tag)}</a>)}
          </div>
        )}
      </footer>
    </div>
    {image?.src ? (
      <a class="post-summary__image" href={href} tabindex="-1" aria-hidden="true" data-astro-prefetch="hover">
        <img src={image.src} width={image.width} height={image.height} alt="" loading="lazy" />
      </a>
    ) : (
      <div class="post-summary__image post-summary__image--blank blueprint" aria-hidden="true" data-no-select>
        <span>{index ? String(index).padStart(2, '0') : 'NEW'}</span>
        <small>FIG. — TEXT ONLY</small>
      </div>
    )}
  </article>
) : (
  <article class="archive-entry">
    <span class="archive-entry__index" data-no-select>{String(index ?? 0).padStart(2, '0')}</span>
    {shortDate && <time datetime={isoDate}>{shortDate}</time>}
    <a href={href} data-astro-prefetch="hover">{data.title}</a>
    <span class="archive-entry__arrow" aria-hidden="true">↗</span>
  </article>
)}

<style>
  .post-summary {
    position: relative;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    transition: background-color 0.18s ease;
  }

  .post-summary:hover {
    background: var(--panel);
  }

  .post-summary__image {
    position: relative;
    order: -1;
    aspect-ratio: 16 / 10;
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }

  .post-summary__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.85);
    transition: filter 0.3s ease;
  }

  .post-summary:hover .post-summary__image img {
    filter: saturate(1);
  }

  .post-summary__image--blank {
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .post-summary__image--blank span {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .post-summary__image--blank small {
    align-self: flex-end;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  .post-summary__copy {
    min-width: 0;
    padding: 1.35rem var(--pad-x) 1.4rem;
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .post-summary__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  .post-summary__topline > span {
    color: var(--accent);
    font-weight: 500;
  }

  .post-summary h2 {
    margin: 0.9rem 0 0.7rem;
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    line-height: 1.22;
  }

  .post-summary h2 a {
    color: var(--ink);
  }

  .post-summary h2 a::after {
    position: absolute;
    z-index: 0;
    inset: 0;
    content: "";
  }

  .post-summary h2 a:hover {
    color: var(--accent);
  }

  .post-summary__meta,
  .post-summary footer {
    position: relative;
    z-index: 1;
  }

  .post-summary__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .post-summary__meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink-2);
  }

  .post-summary__meta a:hover {
    color: var(--accent);
  }

  .post-summary__meta > * + *::before {
    margin-right: 0.5rem;
    content: "/";
    color: var(--line-strong);
  }

  .post-summary__copy > p {
    margin: 0.9rem 0 0;
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.7;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-summary footer {
    margin-top: auto;
    padding-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .read-more:hover {
    color: var(--accent);
  }

  .post-summary__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.35rem;
  }

  .post-summary__tags a {
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink-3);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .post-summary__tags a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .archive-entry {
    position: relative;
    min-width: 0;
    min-height: 3.4rem;
    padding: 0.8rem var(--pad-x);
    display: grid;
    grid-template-columns: 2rem 3.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.15s ease;
  }

  .archive-entry:last-child {
    border-bottom: 0;
  }

  .archive-entry:hover {
    background: var(--panel);
  }

  .archive-entry__index,
  .archive-entry time {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-entry__index {
    color: var(--accent);
    font-size: 0.6875rem;
  }

  .archive-entry a {
    min-width: 0;
    overflow: hidden;
    color: var(--ink);
    font-size: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-entry a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .archive-entry:hover a {
    color: var(--accent);
  }

  .archive-entry__arrow {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0;
    transform: translateX(-0.25rem);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .archive-entry:hover .archive-entry__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 48rem) {
    .archive-entry {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .archive-entry__index {
      display: none;
    }

    .archive-entry a {
      font-size: 0.9375rem;
      white-space: normal;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }
</style>
