---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面未找到。" noindex={true}>
  <div class="frame not-found">
    <div class="not-found__plate" aria-hidden="true">
      <div class="not-found__signal"><span>4</span><b>0</b><span>4</span></div>
      <span class="not-found__coord not-found__coord--tl">LAT ——.——</span>
      <span class="not-found__coord not-found__coord--tr">LON ——.——</span>
      <span class="not-found__coord not-found__coord--bl">FIG. 404 — NO SIGNAL</span>
      <span class="not-found__coord not-found__coord--br">NOT TO SCALE</span>
    </div>
    <div class="not-found__copy">
      <p><b>ERROR 404</b> / LOST IN THE INDEX</p>
      <h1>这一页没有留下坐标。</h1>
      <span>地址可能已经移动，也可能只是一次漂亮的拼写错误。</span>
      <nav aria-label="恢复导航">
        <a class="btn btn--primary" href="/">回到首页 <Icon name="arrow" size={15} /></a>
        <a class="btn" href="/search/"><Icon name="search" size={15} /> 搜索文章</a>
        <a class="btn btn--ghost" href="/posts/">浏览归档</a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - var(--header-h) - 9rem);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .not-found__plate {
    position: relative;
    min-height: 22rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-right: 1px solid var(--line);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) center / 1.2rem 1.2rem,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) center / 1.2rem 1.2rem,
      var(--panel);
  }

  .not-found__plate::before,
  .not-found__plate::after {
    position: absolute;
    content: "";
    background: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .not-found__plate::before {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .not-found__plate::after {
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
  }

  .not-found__signal {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.05em;
    color: var(--ink);
    font-family: var(--font-code);
    font-size: clamp(5rem, 13vw, 9rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .not-found__signal b {
    width: 0.75em;
    height: 0.75em;
    display: inline-grid;
    place-items: center;
    border: 1px dashed var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-size: 0.55em;
    font-weight: 400;
    letter-spacing: 0;
    animation: not-found-spin 18s linear infinite;
  }

  @keyframes not-found-spin {
    to { transform: rotate(360deg); }
  }

  .not-found__coord {
    position: absolute;
    z-index: 1;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }

  .not-found__coord--tl { top: 0.8rem; left: 0.9rem; }
  .not-found__coord--tr { top: 0.8rem; right: 0.9rem; }
  .not-found__coord--bl { bottom: 0.8rem; left: 0.9rem; }
  .not-found__coord--br { right: 0.9rem; bottom: 0.8rem; }

  .not-found__copy {
    min-width: 0;
    padding: 2.5rem var(--pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .not-found__copy > p {
    margin: 0 0 1rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
  }

  .not-found__copy > p b {
    color: var(--accent);
    font-weight: 500;
  }

  .not-found h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .not-found__copy > span {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .not-found nav {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 60rem) {
    .not-found__copy > p,
    .not-found__coord { font-size: 0.62rem; }
    .not-found__copy > span { font-size: 0.95rem; }
  }

  @media (max-width: 48rem) {
    .not-found {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .not-found__plate {
      min-height: 15rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .not-found__coord--tr,
    .not-found__coord--br { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__signal b { animation: none; }
  }
</style>
