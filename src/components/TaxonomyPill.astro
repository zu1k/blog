---
export interface Props {
  label: string;
  href?: string;
  count?: number;
  kind?: 'tag' | 'category' | 'plain';
}

const { label, href, count, kind = 'tag' } = Astro.props;
const prefix = kind === 'tag' ? '#' : kind === 'category' ? '§' : '';
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['taxonomy-pill', `taxonomy-pill--${kind}`]} href={href}>
  <span aria-hidden="true">{prefix}</span>{label}{typeof count === 'number' && <small>{count}</small>}
</Tag>

<style>
  .taxonomy-pill {
    min-height: 1.75rem;
    padding: 0.2rem 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    transition:
      color 130ms ease,
      border-color 130ms ease,
      background-color 130ms ease;
  }

  .taxonomy-pill > span {
    color: var(--accent);
  }

  .taxonomy-pill small {
    margin-left: 0.15rem;
    padding-left: 0.4rem;
    border-left: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 0.6875rem;
    font-weight: 400;
  }

  a.taxonomy-pill:hover {
    border-color: var(--accent);
    color: var(--ink);
    background: var(--panel);
  }
</style>
