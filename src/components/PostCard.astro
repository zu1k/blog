---
import Icon from './Icon.astro';
import { formatDate, getPostSlug, getPostUrl, getTaxonomyLabel, getTaxonomyUrl, toDate } from '../lib/content';

type PostData = {
  title: string;
  slug?: string;
  description?: string;
  summary?: string;
  date?: Date | string;
  tags?: string[];
  categories?: string[];
  resources?: Array<Record<string, unknown>>;
};

type PostLike = (PostData | { data: PostData }) & {
  id?: string;
  slug?: string;
  href?: string;
  url?: string;
};

export interface Props {
  post: PostLike;
  variant?: 'summary' | 'archive';
  index?: number;
}

const { post, variant = 'archive', index } = Astro.props;
const data: PostData = (post as { data?: PostData }).data ?? (post as PostData);
const slug = data.slug ?? post.slug ?? post.id ?? '';
const href = post.href ?? post.url ?? getPostUrl(slug);
const description = data.summary ?? data.description;
const date = data.date ? toDate(data.date) : undefined;
const dateText = date && !Number.isNaN(date.valueOf()) ? formatDate(date, 'short') : undefined;
const shortDate = dateText?.slice(5);
const isoDate = date && !Number.isNaN(date.valueOf()) ? date.toISOString() : undefined;
const categories = data.categories ?? [];
const tags = data.tags ?? [];
const featured = data.resources?.find((resource) => resource.name === 'featured-image');
const featuredSrc = typeof featured?.src === 'string' ? featured.src : undefined;
const imageModules = import.meta.glob('../content/posts/**/*.{png,jpg,jpeg,webp,gif}', { eager: true });
const imageKey = featuredSrc ? `../content/posts/${getPostSlug(slug)}/${featuredSrc}` : undefined;
const imageModule = imageKey ? imageModules[imageKey] as { default?: { src?: string; width?: number; height?: number } } | undefined : undefined;
const image = imageModule?.default;
---

{variant === 'summary' ? (
  <article class:list={['post-summary', { 'has-image': image?.src }]}>
    <div class="post-summary__copy">
      <div class="post-summary__topline">
        <span>{index ? String(index).padStart(2, '0') : 'NEW'}</span>
        {dateText && <time datetime={isoDate}>{dateText}</time>}
      </div>
      <h2><a href={href} data-astro-prefetch="hover">{data.title}</a></h2>
      <div class="post-summary__meta">
        {categories[0] && (
          <a href={getTaxonomyUrl('categories', categories[0])}>
            <Icon name="folder" size={13} /> {getTaxonomyLabel('categories', categories[0])}
          </a>
        )}
        <span>BY ZU1K</span>
      </div>
      {description && <p>{description}</p>}
      <footer>
        <a class="read-more" href={href} data-astro-prefetch="hover">阅读全文 <Icon name="arrow" size={15} /></a>
        {tags.length > 0 && (
          <div class="post-summary__tags" aria-label="标签">
            {tags.slice(0, 3).map((tag) => <a href={getTaxonomyUrl('tags', tag)}>#{getTaxonomyLabel('tags', tag)}</a>)}
          </div>
        )}
      </footer>
    </div>
    {image?.src && (
      <a class="post-summary__image" href={href} tabindex="-1" aria-hidden="true" data-astro-prefetch="hover">
        <img src={image.src} width={image.width} height={image.height} alt="" loading="lazy" />
      </a>
    )}
  </article>
) : (
  <article class="archive-entry">
    <span class="archive-entry__index" data-no-select>{String(index ?? 0).padStart(2, '0')}</span>
    {shortDate && <time datetime={isoDate}>{shortDate}</time>}
    <a href={href} data-astro-prefetch="hover">{data.title}</a>
    <span class="archive-entry__arrow" aria-hidden="true">↗</span>
  </article>
)}

<style>
  .post-summary {
    padding: 1.35rem 0 1.4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.2rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .post-summary:first-child {
    border-top-color: var(--ink);
  }

  .post-summary.has-image {
    grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.42fr);
  }

  .post-summary__copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .post-summary__topline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.54rem;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  .post-summary__topline > span {
    color: var(--accent);
    font-weight: 500;
  }

  .post-summary__topline > time::before {
    margin-right: 0.75rem;
    color: var(--line-strong);
    content: "/";
  }

  .post-summary h2 {
    max-width: 26ch;
    margin: 0.55rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.18;
  }

  .post-summary h2 a {
    color: var(--ink);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s ease, color 0.15s ease;
  }

  .post-summary h2 a:hover {
    color: var(--accent);
    background-size: 100% 1px;
  }

  .post-summary__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.52rem;
    letter-spacing: 0.06em;
  }

  .post-summary__meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-2);
  }

  .post-summary__meta a:hover {
    color: var(--accent);
  }

  .post-summary__meta > * + *::before {
    margin-right: 0.6rem;
    content: "·";
    color: var(--line-strong);
  }

  .post-summary > .post-summary__copy > p {
    max-width: 36rem;
    margin: 0.85rem 0 0;
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-2);
    font-size: 0.72rem;
    line-height: 1.8;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-summary footer {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    font-size: 0.64rem;
    font-weight: 500;
  }

  .read-more :global(.icon) {
    transition: transform 0.2s ease;
  }

  .read-more:hover {
    color: var(--accent);
  }

  .read-more:hover :global(.icon) {
    transform: translateX(0.15rem);
  }

  .post-summary__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.35rem;
  }

  .post-summary__tags a {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--ink-2);
    background: var(--panel);
    font-family: var(--font-code);
    font-size: 0.5rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .post-summary__tags a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-summary__image {
    position: relative;
    min-height: 9rem;
    display: block;
    align-self: stretch;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--panel-2);
  }

  .post-summary__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.02);
    transition: filter 0.35s ease, transform 0.5s ease;
  }

  .post-summary__image:hover img {
    filter: none;
    transform: scale(1.02);
  }

  .archive-entry {
    min-width: 0;
    min-height: 2.6rem;
    padding: 0.5rem 0.4rem;
    display: grid;
    grid-template-columns: 1.8rem 2.8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.15s ease;
  }

  .archive-entry:hover {
    background: var(--panel);
  }

  .archive-entry__index,
  .archive-entry time {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.54rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-entry__index {
    color: var(--accent);
  }

  .archive-entry a {
    min-width: 0;
    overflow: hidden;
    color: var(--ink);
    font-size: 0.74rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-entry a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .archive-entry {
    position: relative;
  }

  .archive-entry:hover a {
    color: var(--accent);
  }

  .archive-entry__arrow {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.62rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .archive-entry:hover .archive-entry__arrow {
    color: var(--accent);
    transform: translate(0.12rem, -0.12rem);
  }

  @media (max-width: 60rem) {
    .post-summary__topline,
    .post-summary__meta { font-size: 0.64rem; }
    .post-summary > .post-summary__copy > p { font-size: 0.9rem; }
    .read-more { font-size: 0.8rem; }
    .post-summary__tags a { font-size: 0.62rem; }
    .archive-entry__index,
    .archive-entry time { font-size: 0.66rem; }
    .archive-entry a { font-size: 0.92rem; }
    .archive-entry__arrow { font-size: 0.75rem; }
  }

  @media (max-width: 48rem) {
    .post-summary,
    .post-summary.has-image {
      grid-template-columns: 1fr;
    }

    .post-summary__image {
      min-height: 0;
      aspect-ratio: 16 / 8;
      grid-row: 1;
    }

    .post-summary footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.6rem;
    }

    .post-summary__tags {
      justify-content: start;
    }

    .archive-entry {
      grid-template-columns: 2.8rem minmax(0, 1fr) auto;
      gap: 0.55rem;
      padding-inline: 0;
    }

    .archive-entry__index {
      display: none;
    }
  }
</style>
