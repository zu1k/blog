---
import type { PostEntry } from '../lib/content';
import PageHero from './PageHero.astro';
import PostCard from './PostCard.astro';

export interface Props {
  posts: PostEntry[];
  title: string;
  description?: string;
  eyebrow?: string;
  totalCount?: number;
  page?: number;
  totalPages?: number;
  paginationBase?: string;
}

const {
  posts,
  title,
  description = `${posts.length} 篇文章，按时间倒序排列。`,
  eyebrow = 'WRITING / ARCHIVE',
  totalCount = posts.length,
  page = 1,
  totalPages = 1,
  paginationBase = '/posts/',
} = Astro.props;

const grouped = posts.reduce((years, post) => {
  const year = post.data.date.getFullYear();
  const entries = years.get(year) ?? [];
  entries.push(post);
  years.set(year, entries);
  return years;
}, new Map<number, PostEntry[]>());

const postIndexes = new Map(posts.map((post, index) => [post.id, index + 1 + (page - 1) * 20]));
const pageUrl = (value: number) => value === 1 ? paginationBase : `${paginationBase}page/${value}/`;
---

<section class="archive-page" aria-labelledby="archive-title">
  <PageHero eyebrow={eyebrow} title={title} description={description} mark={totalCount} compact>
    <div slot="aside">
      <strong>{totalCount}</strong> 篇公开文章<br />
      {totalPages > 1 ? `第 ${page} / ${totalPages} 页` : '完整时间索引'}
    </div>
  </PageHero>

  <div class="archive-ledger">
    {[...grouped.entries()].map(([year, yearPosts]) => (
      <section class="archive-year" aria-labelledby={`year-${year}`}>
        <header>
          <h2 id={`year-${year}`}>{year}</h2>
          <span>{String(yearPosts.length).padStart(2, '0')} POSTS</span>
        </header>
        <div class="archive-year__entries">
          {yearPosts.map((post) => <PostCard post={post} index={postIndexes.get(post.id)} />)}
        </div>
      </section>
    ))}
  </div>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="分页" data-no-select>
      <span>PAGE</span>
      {Array.from({ length: totalPages }, (_, index) => index + 1).map((value) => (
        <a href={pageUrl(value)} aria-current={value === page ? 'page' : undefined} data-astro-prefetch="hover">{String(value).padStart(2, '0')}</a>
      ))}
    </nav>
  )}
</section>

<style>
  .archive-page {
    width: var(--frame);
    margin: 0 auto;
    padding: 0;
  }

  .archive-page :global(.page-hero__aside strong) {
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 1.1rem;
    font-weight: 400;
  }

  .archive-ledger {
    padding: 0;
  }

  .archive-year {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }

  .archive-year:first-child {
    border-top: 0;
  }

  .archive-year > header {
    min-width: 0;
    padding: 1.4rem 1.1rem;
    border-right: 1px solid var(--line);
  }

  .archive-year > header > * {
    position: sticky;
    top: calc(var(--header-h) + 1.4rem);
  }

  .archive-year h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .archive-year header span {
    display: block;
    margin-top: 0.4rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }

  .archive-year header span {
    top: calc(var(--header-h) + 3.2rem);
  }

  .archive-year__entries {
    min-width: 0;
    padding: 0.9rem var(--pad) 1.6rem;
  }

  .archive-year__entries :global(.archive-entry:first-child) {
    border-top: 1px solid var(--ink);
  }

  .pagination {
    padding: 0.8rem var(--pad);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    border-top: 1px solid var(--line);
  }

  .pagination > span {
    margin-right: 0.6rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.52rem;
    letter-spacing: 0.12em;
  }

  .pagination a {
    min-width: 1.8rem;
    height: 1.8rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--ink-2);
    font-family: var(--font-code);
    font-size: 0.6rem;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .pagination a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .pagination a[aria-current="page"] {
    border-color: var(--ink);
    color: var(--bg);
    background: var(--ink);
  }

  @media (max-width: 60rem) {
    .archive-year header span,
    .pagination > span { font-size: 0.62rem; }
    .pagination a { font-size: 0.72rem; }
  }

  @media (max-width: 48rem) {
    .archive-year {
      grid-template-columns: 1fr;
    }

    .archive-year > header {
      padding: 1.2rem var(--pad) 0;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-right: 0;
    }

    .archive-year > header > * {
      position: static;
    }

    .archive-year h2 {
      font-size: 1.3rem;
    }

    .archive-year header span {
      margin-top: 0;
    }

    .archive-year__entries {
      padding-top: 0.7rem;
    }
  }
</style>
