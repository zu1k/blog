---
export interface Props {
  mermaid?: boolean;
}

const { mermaid = false } = Astro.props;
---

<dialog class="image-viewer" data-image-viewer aria-label="图片预览">
  <button type="button" data-image-close aria-label="关闭图片预览">×</button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
</dialog>

<script>
  const article = document.querySelector<HTMLElement>('.article-body');

  const languageNames: Record<string, string> = {
    bash: 'Bash',
    c: 'C',
    cpp: 'C++',
    'c++': 'C++',
    csharp: 'C#',
    cs: 'C#',
    css: 'CSS',
    docker: 'Dockerfile',
    dockerfile: 'Dockerfile',
    go: 'Go',
    golang: 'Go',
    html: 'HTML',
    ini: 'INI',
    java: 'Java',
    javascript: 'JavaScript',
    js: 'JavaScript',
    json: 'JSON',
    jsx: 'JSX',
    markdown: 'Markdown',
    md: 'Markdown',
    nginx: 'Nginx',
    php: 'PHP',
    plaintext: 'Plain text',
    text: 'Plain text',
    powershell: 'PowerShell',
    ps1: 'PowerShell',
    python: 'Python',
    py: 'Python',
    rust: 'Rust',
    sh: 'Shell',
    shell: 'Shell',
    sql: 'SQL',
    toml: 'TOML',
    ts: 'TypeScript',
    tsx: 'TSX',
    typescript: 'TypeScript',
    xml: 'XML',
    yaml: 'YAML',
    yml: 'YAML',
  };

  const getLanguageName = (pre: HTMLPreElement) => {
    const classLanguage = [...(pre.querySelector('code')?.classList ?? [])]
      .find((name) => name.startsWith('language-'))
      ?.slice('language-'.length);
    const language = (pre.dataset.language || classLanguage || 'plaintext').toLocaleLowerCase();
    return languageNames[language] || language.replace(/(^|[-_])(\w)/g, (_, separator, letter) => `${separator}${letter.toUpperCase()}`);
  };

  article?.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
    if (pre.dataset.language?.toLocaleLowerCase() === 'mermaid' || pre.querySelector('code.language-mermaid') || pre.closest('.code-frame')) return;
    const language = getLanguageName(pre);
    const frame = document.createElement('div');
    frame.className = 'code-frame';
    frame.role = 'group';
    frame.setAttribute('aria-label', `${language} 代码片段`);
    pre.parentNode?.insertBefore(frame, pre);

    const languageLabel = document.createElement('span');
    languageLabel.className = 'code-language';
    const languageValue = document.createElement('strong');
    languageValue.textContent = language;
    languageLabel.append(languageValue);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = '复制';
    button.setAttribute('aria-label', '复制代码');
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = '已复制';
        button.dataset.state = 'success';
      } catch {
        button.textContent = '复制失败';
        button.dataset.state = 'error';
      }
      window.setTimeout(() => {
        button.textContent = '复制';
        delete button.dataset.state;
      }, 1600);
    });
    frame.append(languageLabel, button, pre);
  });

  const viewer = document.querySelector<HTMLDialogElement>('[data-image-viewer]');
  const viewerImage = viewer?.querySelector<HTMLImageElement>('img');
  const viewerCaption = viewer?.querySelector<HTMLElement>('figcaption');

  article?.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
    image.tabIndex = 0;
    image.role = 'button';
    image.setAttribute('aria-label', `${image.alt || '图片'}，点击放大`);
    const open = () => {
      if (!viewer || !viewerImage || !viewerCaption) return;
      viewerImage.src = image.currentSrc || image.src;
      viewerImage.alt = image.alt;
      viewerCaption.textContent = image.alt;
      viewerCaption.hidden = !image.alt;
      viewer.showModal();
    };
    image.addEventListener('click', open);
    image.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open();
      }
    });
  });

  viewer?.querySelector('[data-image-close]')?.addEventListener('click', () => viewer.close());
  viewer?.addEventListener('click', (event) => {
    if (event.target === viewer) viewer.close();
  });
</script>

{mermaid && (
  <script>
    const mermaidArticle = document.querySelector<HTMLElement>('.article-body');
    const mermaidBlocks = [...(mermaidArticle?.querySelectorAll<HTMLPreElement>('pre') ?? [])]
      .filter((pre) => pre.dataset.language?.toLocaleLowerCase() === 'mermaid' || Boolean(pre.querySelector(':scope > code.language-mermaid')));

    if (mermaidBlocks.length > 0) {
      const [{ default: mermaidApi }, { default: Prism }] = await Promise.all([
        import('mermaid'),
        import('prismjs'),
      ]);
      await import('prismjs/components/prism-mermaid.js');

      const diagrams = mermaidBlocks.map((pre, index) => {
        const source = pre.querySelector('code')?.textContent?.trim() ?? pre.textContent?.trim() ?? '';
        const code = pre.querySelector('code');
        if (code && Prism.languages.mermaid) {
          const highlighted = document.createElement('template');
          highlighted.innerHTML = Prism.highlight(source, Prism.languages.mermaid, 'mermaid');
          code.replaceChildren(highlighted.content);
        }
        const frame = document.createElement('figure');
        const status = document.createElement('p');
        const canvas = document.createElement('div');
        const toggle = document.createElement('button');

        frame.className = 'mermaid-frame';
        frame.dataset.state = 'loading';
        frame.dataset.view = 'diagram';
        frame.setAttribute('aria-label', `Mermaid 图表 ${index + 1}`);
        status.className = 'mermaid-error';
        status.hidden = true;
        canvas.className = 'mermaid-canvas';
        canvas.id = `mermaid-view-${index}`;
        canvas.role = 'img';
        canvas.setAttribute('aria-label', `文章中的 Mermaid 图表 ${index + 1}`);
        pre.classList.add('mermaid-source');
        pre.id = `mermaid-source-${index}`;
        pre.hidden = true;
        toggle.className = 'mermaid-toggle';
        toggle.type = 'button';
        toggle.textContent = '查看源码';
        toggle.setAttribute('aria-controls', `${canvas.id} ${pre.id}`);
        toggle.setAttribute('aria-pressed', 'false');
        toggle.setAttribute('aria-label', `查看第 ${index + 1} 张 Mermaid 图表的源码`);
        toggle.addEventListener('click', () => {
          const showSource = frame.dataset.view !== 'source';
          frame.dataset.view = showSource ? 'source' : 'diagram';
          canvas.hidden = showSource;
          pre.hidden = !showSource;
          toggle.textContent = showSource ? '返回图表' : '查看源码';
          toggle.setAttribute('aria-pressed', String(showSource));
          toggle.setAttribute('aria-label', showSource
            ? `返回第 ${index + 1} 张 Mermaid 图表`
            : `查看第 ${index + 1} 张 Mermaid 图表的源码`);
        });

        pre.parentNode?.insertBefore(frame, pre);
        frame.append(canvas, status, toggle, pre);

        return { source, frame, canvas, status, toggle, pre };
      });

      const getMermaidConfig = () => {
        const styles = getComputedStyle(document.documentElement);
        const css = (name: string) => styles.getPropertyValue(name).trim();
        const isDark = document.documentElement.dataset.theme === 'dark';

        return {
          startOnLoad: false,
          securityLevel: 'strict' as const,
          suppressErrorRendering: true,
          theme: 'base' as const,
          fontFamily: css('--font-serif'),
          themeVariables: {
            darkMode: isDark,
            background: css('--page-bg'),
            fontFamily: css('--font-serif'),
            fontSize: '15px',
            primaryColor: css('--surface-soft'),
            primaryTextColor: css('--text'),
            primaryBorderColor: css('--border-strong'),
            secondaryColor: css('--page-raised'),
            secondaryTextColor: css('--text'),
            secondaryBorderColor: css('--border-strong'),
            tertiaryColor: css('--code-bg'),
            tertiaryTextColor: css('--text'),
            tertiaryBorderColor: css('--border'),
            lineColor: css('--muted'),
            textColor: css('--secondary'),
            noteBkgColor: css('--surface-soft'),
            noteTextColor: css('--text'),
            noteBorderColor: css('--accent'),
            actorBkg: css('--surface-soft'),
            actorBorder: css('--border-strong'),
            actorTextColor: css('--text'),
            actorLineColor: css('--muted'),
            signalColor: css('--secondary'),
            signalTextColor: css('--text'),
            labelBoxBkgColor: css('--page-raised'),
            labelBoxBorderColor: css('--border-strong'),
            labelTextColor: css('--text'),
            loopTextColor: css('--text'),
            activationBkgColor: css('--code-bg'),
            activationBorderColor: css('--accent'),
            sequenceNumberColor: css('--page-bg'),
          },
        };
      };

      let renderVersion = 0;
      let renderQueue = Promise.resolve();

      const renderDiagrams = async () => {
        const version = ++renderVersion;
        mermaidApi.initialize(getMermaidConfig());

        for (const [index, diagram] of diagrams.entries()) {
          diagram.frame.dataset.state = 'loading';
          diagram.status.hidden = true;
          diagram.status.textContent = '';
          diagram.canvas.setAttribute('aria-busy', 'true');

          try {
            diagram.frame.dataset.diagramType = mermaidApi.detectType(diagram.source);
            const renderId = `mermaid-svg-${version}-${index}`;
            const { svg, bindFunctions } = await mermaidApi.render(renderId, diagram.source);
            if (version !== renderVersion) return;

            const template = document.createElement('template');
            template.innerHTML = svg.trim();
            const svgElement = template.content.querySelector('svg');
            if (!svgElement) throw new Error('Mermaid did not return an SVG element.');

            svgElement.removeAttribute('height');
            svgElement.setAttribute('role', 'img');
            svgElement.setAttribute('aria-label', `文章中的 Mermaid 图表 ${index + 1}`);
            svgElement.setAttribute('focusable', 'false');
            diagram.canvas.replaceChildren(template.content);
            bindFunctions?.(diagram.canvas);
            diagram.frame.dataset.state = 'ready';
            diagram.toggle.hidden = false;
          } catch (error) {
            if (version !== renderVersion) return;
            diagram.canvas.replaceChildren();
            diagram.frame.dataset.state = 'error';
            diagram.frame.dataset.view = 'source';
            diagram.status.hidden = false;
            diagram.status.textContent = '图表渲染失败，下面保留了原始 Mermaid 源码。';
            diagram.canvas.hidden = true;
            diagram.pre.hidden = false;
            diagram.toggle.hidden = true;
            console.error(`Mermaid diagram ${index + 1} failed to render.`, error);
          } finally {
            diagram.canvas.removeAttribute('aria-busy');
          }
        }
      };

      const queueRender = () => {
        renderQueue = renderQueue.then(renderDiagrams, renderDiagrams);
      };

      if ('fonts' in document) await document.fonts.ready;
      queueRender();

      let lastTheme = document.documentElement.dataset.theme;
      new MutationObserver(() => {
        const nextTheme = document.documentElement.dataset.theme;
        if (nextTheme === lastTheme) return;
        lastTheme = nextTheme;
        queueRender();
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    }
  </script>
)}

<style>
  /* Code blocks become a framed "editor pane": a label strip on top, code below. */
  :global(.code-frame) {
    position: relative;
    margin-block: 1.6em;
    border: 1px solid var(--line-strong);
    background: var(--code-bg);
  }

  :global(.code-frame)::before {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    left: 0;
    height: 2.25rem;
    content: "";
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
    pointer-events: none;
  }

  :global(.article-body .code-frame pre) {
    margin-block: 0;
    padding-top: calc(2.25rem + 0.9rem);
    border: 0;
    background: transparent !important;
  }

  :global(.code-language) {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    height: 2.25rem;
    padding: 0 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  :global(.code-language)::before {
    width: 6px;
    height: 6px;
    content: "";
    background: var(--accent);
  }

  :global(.code-language strong) {
    color: var(--ink-2);
    font: inherit;
    font-weight: 500;
  }

  :global(.code-copy) {
    position: absolute;
    z-index: 2;
    top: 0.35rem;
    right: 0.4rem;
    min-height: 1.55rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  :global(.code-copy:hover),
  :global(.code-copy:focus-visible) {
    border-color: var(--ink);
    color: var(--bg);
    outline: 0;
    background: var(--ink);
  }

  :global(.code-copy[data-state="success"]) {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  :global(.code-copy[data-state="error"]) {
    border-color: var(--warn);
    color: var(--warn);
    background: var(--bg);
  }

  .image-viewer {
    width: min(94vw, 90rem);
    max-width: none;
    max-height: 92vh;
    padding: 3rem 1rem 1rem;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    background: var(--bg);
  }

  .image-viewer::backdrop {
    background: rgb(12 12 11 / 78%);
  }

  .image-viewer > button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }

  .image-viewer > button:hover,
  .image-viewer > button:focus-visible {
    border-color: var(--ink);
    color: var(--bg);
    outline: 0;
    background: var(--ink);
  }

  .image-viewer figure {
    margin: 0;
  }

  .image-viewer img {
    width: auto;
    max-height: calc(92vh - 5.5rem);
    margin: auto;
    display: block;
  }

  .image-viewer figcaption {
    margin-top: 0.75rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
  }

  :global(.article-body img[role="button"]) {
    cursor: zoom-in;
  }

  :global(.mermaid-frame) {
    position: relative;
    margin: 1.6em 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    text-align: left;
  }

  :global(.mermaid-canvas) {
    min-height: 9rem;
    padding: clamp(2.75rem, 5vw, 3.25rem) clamp(0.9rem, 3vw, 1.5rem) clamp(0.9rem, 3vw, 1.5rem);
    overflow-x: auto;
    display: grid;
    place-items: center;
    background-color: var(--panel);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-position: -1px -1px;
    background-size: 24px 24px;
    scrollbar-width: thin;
  }

  :global(.mermaid-canvas[aria-busy="true"]) {
    opacity: 0.55;
  }

  :global(.mermaid-canvas svg) {
    width: 100%;
    height: auto;
    max-width: 100%;
    display: block;
  }

  :global(.mermaid-error) {
    margin: 0;
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--line);
    color: var(--warn);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: left;
  }

  :global(.mermaid-toggle) {
    position: absolute;
    z-index: 2;
    top: 0.5rem;
    right: 0.5rem;
    min-height: 1.6rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    cursor: pointer;
  }

  :global(.mermaid-toggle:hover),
  :global(.mermaid-toggle:focus-visible) {
    border-color: var(--ink);
    color: var(--bg);
    outline: 0;
    background: var(--ink);
  }

  :global(.mermaid-frame > .mermaid-source) {
    margin: 0;
    padding-top: 2.75rem;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    text-align: left;
  }

  :global(.mermaid-frame > .mermaid-source[hidden]),
  :global(.mermaid-canvas[hidden]) {
    display: none;
  }

  :global(.mermaid-frame > .mermaid-source code) {
    display: block;
    text-align: left;
  }

  :global(.mermaid-source .token.comment) {
    color: var(--ink-3);
    font-style: italic;
  }

  :global(.mermaid-source .token.keyword),
  :global(.mermaid-source .token.important) {
    color: var(--warn);
    font-weight: 600;
  }

  :global(.mermaid-source .token.arrow),
  :global(.mermaid-source .token.operator) {
    color: var(--accent);
  }

  :global(.mermaid-source .token.string),
  :global(.mermaid-source .token.property) {
    color: color-mix(in srgb, #31824f 76%, var(--ink));
  }

  :global(.mermaid-source .token.entity),
  :global(.mermaid-source .token.function),
  :global(.mermaid-source .token.variable) {
    color: color-mix(in srgb, #7857b5 72%, var(--ink));
  }

  :global(:root[data-theme="dark"] .mermaid-source .token.string),
  :global(:root[data-theme="dark"] .mermaid-source .token.property) {
    color: #9bcfa6;
  }

  :global(:root[data-theme="dark"] .mermaid-source .token.entity),
  :global(:root[data-theme="dark"] .mermaid-source .token.function),
  :global(:root[data-theme="dark"] .mermaid-source .token.variable) {
    color: #c8a9ef;
  }

  @media (max-width: 42rem) {
    :global(.mermaid-frame[data-diagram-type="sequence"] .mermaid-canvas svg) {
      min-width: 34rem;
    }
  }
</style>
