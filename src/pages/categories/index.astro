---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPostsByTaxonomy, formatDate, getCategories, getPostUrl, getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
const categories = getCategories(posts, 'count');
---

<BaseLayout title="所有分类" description="按领域浏览 zu1k 的文章。">
  <div class="wide-page categories-page">
    <PageHero
      eyebrow="TOPICS / COLLECTIONS"
      title="所有分类"
      description="把长期写作整理成一组可进入的主题书架。从编程与安全，到生活、经验和对当下的思考。"
      mark={categories.length}
      compact
    >
      <div slot="aside"><strong>{posts.length}</strong> 篇文章<br /><strong>{categories.length}</strong> 个持续主题</div>
    </PageHero>

    <section class="category-library" aria-label="全部分类">
      {categories.map((term, index) => {
        const categoryPosts = filterPostsByTaxonomy(posts, 'categories', term.value);
        return (
          <article class="category-card">
            <header>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b>{term.count} 篇</b>
            </header>
            <h2><a href={term.url}><Icon name="folder" size={20} /> {term.name}</a></h2>
            <ol>
              {categoryPosts.slice(0, 4).map((post) => (
                <li>
                  <a href={getPostUrl(post)}>{post.data.title}</a>
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'short').slice(5)}</time>
                </li>
              ))}
            </ol>
            <a class="category-card__more" href={term.url}>进入主题 <span aria-hidden="true">↗</span></a>
          </article>
        );
      })}
    </section>
  </div>
</BaseLayout>

<style>
  .categories-page :global(.page-hero__aside strong) {
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 1.1rem;
    font-weight: 400;
  }

  .category-library {
    margin: 2rem var(--pad) 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .category-card {
    min-width: 0;
    min-height: 17rem;
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    background: var(--panel);
    transition: background-color 0.2s ease;
  }

  .category-card:hover {
    background: var(--bg);
  }

  .category-card header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }

  .category-card header b {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--ink-2);
    font-weight: 400;
  }

  .category-card h2 {
    margin: 0.7rem 0 0.9rem;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .category-card h2 a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
  }

  .category-card h2 a :global(.icon) {
    width: 0.8em;
    height: 0.8em;
    color: var(--accent);
  }

  .category-card h2 a:hover {
    color: var(--accent);
  }

  .category-card ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .category-card li {
    position: relative;
    padding: 0.42rem 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .category-card li a {
    min-width: 0;
    overflow: hidden;
    color: var(--ink);
    font-size: 0.66rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-card li a:hover {
    color: var(--accent);
  }

  .category-card li time {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .category-card__more {
    margin-top: auto;
    padding-top: 0.9rem;
    align-self: flex-start;
    display: inline-flex;
    gap: 0.35rem;
    color: var(--ink-2);
    font-family: var(--font-code);
    font-size: 0.54rem;
    letter-spacing: 0.04em;
  }

  .category-card__more span {
    transition: transform 0.15s ease;
  }

  .category-card__more:hover {
    color: var(--accent);
  }

  .category-card__more:hover span {
    transform: translate(0.1rem, -0.1rem);
  }

  @media (max-width: 60rem) {
    .category-card header,
    .category-card__more { font-size: 0.64rem; }
    .category-card li a { font-size: 0.86rem; }
    .category-card li time { font-size: 0.62rem; }
  }

  @media (max-width: 48rem) {
    .category-library {
      margin: 1.2rem var(--pad) 0;
      grid-template-columns: 1fr;
    }

    .category-card {
      min-height: 0;
    }
  }
</style>
