---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTags } from '../../lib/content';

const posts = await getPublishedPosts();
const tags = getTags(posts, 'count');
---

<BaseLayout title="所有标签" description="按具体技术、概念与话题浏览 zu1k 的文章。">
  <div class="wide-page tags-page" data-tags-page>
    <PageHero
      eyebrow="KEYWORDS / INDEX"
      title="所有标签"
      description="一份从文章里生长出来的关键词索引。搜索技术、概念或某个阶段反复出现的话题。"
      mark={tags.length}
      compact
    >
      <div slot="aside"><strong>{tags.length}</strong> 个关键词<br />覆盖 <strong>{posts.length}</strong> 篇文章</div>
    </PageHero>

    <section class="tag-explorer" aria-labelledby="tag-explorer-title">
      <header>
        <div>
          <p>EXPLORE THE VOCABULARY</p>
          <h2 id="tag-explorer-title">关键词词典</h2>
        </div>
        <output data-tag-status aria-live="polite">{tags.length} 个标签</output>
      </header>

      <label class="tag-search" for="tag-search-input">
        <Icon name="search" size={18} />
        <span class="visually-hidden">搜索标签</span>
        <input id="tag-search-input" type="search" placeholder="输入标签名称…" autocomplete="off" data-tag-search />
        <button type="button" data-tag-clear hidden>清除</button>
      </label>

      <div class="tag-cloud" aria-label="全部标签" data-tag-cloud>
        {tags.map((term, index) => (
          <a href={term.url} data-tag-item data-search={term.name.normalize('NFKC').toLocaleLowerCase('zh-CN')}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{term.name}</strong>
            <sup>{term.count}</sup>
          </a>
        ))}
      </div>
      <div class="tag-empty" data-tag-empty hidden>没有匹配的标签，试试更短的关键词。</div>
    </section>
  </div>
</BaseLayout>

<script>
  const tagRoot = document.querySelector<HTMLElement>('[data-tags-page]');
  const tagInput = tagRoot?.querySelector<HTMLInputElement>('[data-tag-search]');
  const tagItems = [...(tagRoot?.querySelectorAll<HTMLElement>('[data-tag-item]') ?? [])];
  const tagStatus = tagRoot?.querySelector<HTMLOutputElement>('[data-tag-status]');
  const tagClear = tagRoot?.querySelector<HTMLButtonElement>('[data-tag-clear]');
  const tagEmpty = tagRoot?.querySelector<HTMLElement>('[data-tag-empty]');

  const filterTags = () => {
    const query = (tagInput?.value ?? '').normalize('NFKC').toLocaleLowerCase('zh-CN').trim();
    let count = 0;
    tagItems.forEach((item) => {
      const visible = !query || (item.dataset.search ?? '').includes(query);
      item.hidden = !visible;
      if (visible) count += 1;
    });
    if (tagStatus) tagStatus.textContent = query ? `“${tagInput?.value.trim()}” · ${count} 个结果` : `${count} 个标签`;
    if (tagClear) tagClear.hidden = !query;
    if (tagEmpty) tagEmpty.hidden = count !== 0;
  };

  tagInput?.addEventListener('input', filterTags);
  tagClear?.addEventListener('click', () => {
    if (!tagInput) return;
    tagInput.value = '';
    tagInput.focus();
    filterTags();
  });
</script>

<style>
  .tags-page :global(.page-hero__aside strong) {
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 1.1rem;
    font-weight: 400;
  }

  .tag-explorer {
    padding: 2rem var(--pad) 0;
  }

  .tag-explorer > header {
    margin-bottom: 1rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .tag-explorer > header p {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-family: var(--font-code);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
  }

  .tag-explorer h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .tag-explorer output {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.54rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .tag-search {
    height: 2.4rem;
    margin-bottom: 1.2rem;
    padding: 0 0.35rem 0 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--ink-3);
    background: var(--panel);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .tag-search:focus-within {
    border-color: var(--ink);
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .tag-search input {
    min-width: 0;
    height: 100%;
    flex: 1;
    border: 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.72rem;
  }

  .tag-search input::-webkit-search-cancel-button {
    display: none;
  }

  .tag-search button {
    height: 1.6rem;
    padding: 0 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-code);
    font-size: 0.54rem;
    cursor: pointer;
  }

  .tag-search button:hover {
    border-color: var(--ink);
    color: var(--bg);
    background: var(--ink);
  }

  .tag-search button[hidden] {
    display: none;
  }

  .tag-cloud {
    padding: 1px 0 0 1px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
  }

  .tag-cloud a {
    position: relative;
    min-width: 0;
    min-height: 3.6rem;
    margin: -1px 0 0 -1px;
    padding: 0.5rem 0.65rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    column-gap: 0.4rem;
    border: 1px solid var(--line);
    color: var(--ink);
    background: var(--panel);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .tag-cloud a:hover {
    z-index: 1;
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .tag-cloud a[hidden] { display: none; }

  .tag-cloud span {
    grid-column: 1;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.48rem;
    letter-spacing: 0.06em;
  }

  .tag-cloud strong {
    grid-column: 1 / -1;
    align-self: end;
    min-width: 0;
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-cloud sup {
    grid-column: 2;
    grid-row: 1;
    color: var(--ink-2);
    font-family: var(--font-code);
    font-size: 0.5rem;
    line-height: 1.6;
    vertical-align: baseline;
  }

  .tag-empty {
    padding: 1.5rem 0;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.6rem;
    text-align: center;
  }

  .tag-empty[hidden] {
    display: none;
  }

  @media (max-width: 60rem) {
    .tag-explorer > header p,
    .tag-explorer output,
    .tag-search button { font-size: 0.66rem; }
    .tag-search input { font-size: 0.95rem; }
    .tag-cloud span,
    .tag-cloud sup { font-size: 0.6rem; }
    .tag-cloud strong { font-size: 0.9rem; }
    .tag-empty { font-size: 0.75rem; }
  }

  @media (max-width: 48rem) {
    .tag-explorer {
      padding-top: 1.4rem;
    }

    .tag-explorer > header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.4rem;
    }

    .tag-cloud {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
