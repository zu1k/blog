<div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>

<script>
  const indicator = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const backToTop = document.querySelector<HTMLElement>('[data-back-to-top]');
  let scheduled = false;

  const update = () => {
    scheduled = false;
    const maximum = document.documentElement.scrollHeight - innerHeight;
    const progress = maximum > 0 ? Math.min(1, Math.max(0, scrollY / maximum)) : 0;
    indicator?.style.setProperty('--scroll-progress', String(progress));
    backToTop?.toggleAttribute('data-visible', scrollY > Math.min(520, innerHeight * 0.75));
  };

  const scheduleUpdate = () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(update);
  };

  update();
  addEventListener('scroll', scheduleUpdate, { passive: true });
  addEventListener('resize', scheduleUpdate, { passive: true });
</script>

<style>
  .scroll-progress {
    position: fixed;
    z-index: 151;
    top: calc(var(--header-h) - 1px);
    right: 0;
    left: 0;
    height: 1px;
    overflow: hidden;
    pointer-events: none;
  }

  .scroll-progress span {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--accent);
    transform: scaleX(var(--scroll-progress, 0));
    transform-origin: left center;
    will-change: transform;
  }

  @media print {
    .scroll-progress { display: none; }
  }
</style>
