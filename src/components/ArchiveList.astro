---
import type { PostEntry } from '../lib/content';
import PageHero from './PageHero.astro';
import PostCard from './PostCard.astro';

export interface Props {
  posts: PostEntry[];
  title: string;
  description?: string;
  eyebrow?: string;
  totalCount?: number;
  page?: number;
  totalPages?: number;
  paginationBase?: string;
}

const {
  posts,
  title,
  description = `${posts.length} 篇文章，按时间倒序排列。`,
  eyebrow = 'WRITING / ARCHIVE',
  totalCount = posts.length,
  page = 1,
  totalPages = 1,
  paginationBase = '/posts/',
} = Astro.props;

const grouped = posts.reduce((years, post) => {
  const year = post.data.date.getFullYear();
  const entries = years.get(year) ?? [];
  entries.push(post);
  years.set(year, entries);
  return years;
}, new Map<number, PostEntry[]>());

const postIndexes = new Map(posts.map((post, index) => [post.id, index + 1 + (page - 1) * 20]));
const pageUrl = (value: number) => value === 1 ? paginationBase : `${paginationBase}page/${value}/`;
---

<section class="archive-page" aria-labelledby="archive-title">
  <PageHero eyebrow={eyebrow} title={title} description={description} mark={totalCount} compact>
    <div slot="aside">
      <strong>{totalCount}</strong> 篇公开文章<br />
      {totalPages > 1 ? `第 ${page} / ${totalPages} 页` : '完整时间索引'}
    </div>
  </PageHero>

  <div class="archive-ledger">
    {[...grouped.entries()].map(([year, yearPosts]) => (
      <section class="archive-year band split" aria-labelledby={`year-${year}`}>
        <header class="split__rail">
          <span class="eyebrow" data-no-select><b>{String(yearPosts.length).padStart(2, '0')}</b> / POSTS</span>
          <h2 id={`year-${year}`}>{year}</h2>
        </header>
        <div class="archive-year__entries split__body">
          {yearPosts.map((post) => <PostCard post={post} index={postIndexes.get(post.id)} />)}
        </div>
      </section>
    ))}
  </div>

  {totalPages > 1 && (
    <nav class="pagination band" aria-label="分页" data-no-select>
      <span>PAGE</span>
      {Array.from({ length: totalPages }, (_, index) => index + 1).map((value) => (
        <a href={pageUrl(value)} aria-current={value === page ? 'page' : undefined} data-astro-prefetch="hover">{String(value).padStart(2, '0')}</a>
      ))}
    </nav>
  )}
</section>

<style>
  .archive-page {
    width: 100%;
  }

  .archive-page :global(.page-hero__aside strong) {
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .archive-year {
    grid-template-columns: 11rem minmax(0, 1fr);
  }

  .archive-year > header {
    padding: 1.35rem var(--pad-x);
  }

  .archive-year h2 {
    margin: 0.35rem 0 0;
    color: var(--ink);
    font-size: 2.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: lining-nums;
  }

  .archive-year__entries {
    padding: 0;
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
  }

  .pagination > span {
    min-height: 3.5rem;
    padding: 0 var(--pad-x);
    display: flex;
    align-items: center;
    border-right: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .pagination a {
    min-width: 3.5rem;
    min-height: 3.5rem;
    display: grid;
    place-items: center;
    border-right: 1px solid var(--line);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .pagination a:hover {
    color: var(--accent);
    background: var(--panel);
  }

  .pagination a[aria-current="page"] {
    color: var(--bg);
    background: var(--ink);
  }

  @media (max-width: 52rem) {
    .archive-year {
      grid-template-columns: 1fr;
    }

    .archive-year > header {
      padding: 1rem var(--pad-x);
      display: flex;
      flex-direction: row-reverse;
      align-items: baseline;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
    }

    .archive-year h2 {
      margin: 0;
      font-size: 1.6rem;
    }

    .archive-year__entries.split__body {
      padding: 0;
    }
  }
</style>
