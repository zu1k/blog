---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="comments" aria-labelledby="comments-title" data-giscus-host data-page-title={title}>
  <div class="comments__heading">
    <h2 id="comments-title">评论</h2>
    <p>由 GitHub Discussions 驱动，发布前需要登录 GitHub。</p>
  </div>
  <div class="comments__mount" aria-live="polite"></div>
</section>

<script>
  const hosts = document.querySelectorAll<HTMLElement>('[data-giscus-host]');

  const currentGiscusTheme = () =>
    document.documentElement.dataset.theme === 'dark' ? 'dark_dimmed' : 'light';

  hosts.forEach((host) => {
    const mount = host.querySelector<HTMLElement>('.comments__mount');
    if (!mount || mount.dataset.loaded) return;
    mount.dataset.loaded = 'true';

    const script = document.createElement('script');
    const settings = {
      src: 'https://giscus.app/client.js',
      repo: 'zu1k/blog',
      repoId: 'MDEwOlJlcG9zaXRvcnkzMDExMDQ1OTU=',
      category: 'Comments',
      categoryId: 'DIC_kwDOEfJ9084CA02V',
      mapping: 'og:title',
      strict: '0',
      reactionsEnabled: '1',
      emitMetadata: '0',
      inputPosition: 'top',
      theme: currentGiscusTheme(),
      lang: 'zh-CN',
      loading: 'lazy',
    };

    Object.entries(settings).forEach(([key, value]) => {
      if (key === 'src') script.src = value;
      else script.setAttribute(`data-${key.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}`, value);
    });
    script.async = true;
    script.crossOrigin = 'anonymous';
    mount.append(script);
  });

  let lastTheme = currentGiscusTheme();
  new MutationObserver(() => {
    const theme = currentGiscusTheme();
    if (theme === lastTheme) return;
    lastTheme = theme;
    document.querySelectorAll<HTMLIFrameElement>('iframe.giscus-frame').forEach((frame) => {
      frame.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
    });
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
  .comments {
    position: relative;
    width: var(--frame);
    margin: 0 auto;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }

  .comments__heading {
    min-width: 0;
    padding: 2rem 1.1rem;
    border-right: 1px solid var(--line);
  }

  .comments__heading h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
  }

  .comments__heading h2::before {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--accent);
    content: "COMMENTS";
    font-family: var(--font-code);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .comments__heading > p:last-child {
    margin: 0.55rem 0 0;
    color: var(--ink-3);
    font-size: 0.58rem;
    line-height: 1.7;
  }

  .comments__mount {
    min-width: 0;
    min-height: 12rem;
    max-width: calc(40rem + 2 * var(--pad));
    padding: 2rem var(--pad) 3rem;
  }

  @media (max-width: 60rem) {
    .comments__heading h2::before { font-size: 0.6rem; }
    .comments__heading > p:last-child { font-size: 0.8rem; }
  }

  @media (max-width: 48rem) {
    .comments {
      grid-template-columns: 1fr;
    }

    .comments__heading {
      padding: 1.6rem var(--pad) 0;
      border-right: 0;
    }

    .comments__mount {
      padding: 1.2rem var(--pad) 2.5rem;
    }
  }
</style>
