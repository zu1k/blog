---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTags } from '../../lib/content';

const posts = await getPublishedPosts();
const tags = getTags(posts, 'count');
---

<BaseLayout title="所有标签" description="按具体技术、概念与话题浏览 zu1k 的文章。">
  <div class="wide-page tags-page" data-tags-page>
    <PageHero
      eyebrow="KEYWORDS / INDEX"
      title="所有标签"
      description="一份从文章里生长出来的关键词索引。搜索技术、概念或某个阶段反复出现的话题。"
      mark={tags.length}
      compact
    >
      <div slot="aside"><strong>{tags.length}</strong> 个关键词<br />覆盖 <strong>{posts.length}</strong> 篇文章</div>
    </PageHero>

    <section class="tag-explorer band" aria-labelledby="tag-explorer-title">
      <header>
        <div>
          <p class="eyebrow" data-no-select><b>01</b> / EXPLORE THE VOCABULARY</p>
          <h2 id="tag-explorer-title">关键词词典</h2>
        </div>
        <output data-tag-status aria-live="polite">{tags.length} 个标签</output>
      </header>

      <label class="tag-search" for="tag-search-input">
        <Icon name="search" size={18} />
        <span class="visually-hidden">搜索标签</span>
        <input id="tag-search-input" type="search" placeholder="输入标签名称…" autocomplete="off" data-tag-search />
        <button type="button" class="btn btn--sm" data-tag-clear hidden>清除</button>
      </label>

      <div class="tag-cloud cells cells--open" aria-label="全部标签" data-tag-cloud>
        {tags.map((term, index) => (
          <a href={term.url} data-tag-item data-search={term.name.normalize('NFKC').toLocaleLowerCase('zh-CN')}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{term.name}</strong>
            <sup>{term.count}</sup>
          </a>
        ))}
      </div>
      <div class="tag-empty" data-tag-empty hidden>没有匹配的标签，试试更短的关键词。</div>
    </section>
  </div>
</BaseLayout>

<script>
  const tagRoot = document.querySelector<HTMLElement>('[data-tags-page]');
  const tagInput = tagRoot?.querySelector<HTMLInputElement>('[data-tag-search]');
  const tagItems = [...(tagRoot?.querySelectorAll<HTMLElement>('[data-tag-item]') ?? [])];
  const tagStatus = tagRoot?.querySelector<HTMLOutputElement>('[data-tag-status]');
  const tagClear = tagRoot?.querySelector<HTMLButtonElement>('[data-tag-clear]');
  const tagEmpty = tagRoot?.querySelector<HTMLElement>('[data-tag-empty]');

  const filterTags = () => {
    const query = (tagInput?.value ?? '').normalize('NFKC').toLocaleLowerCase('zh-CN').trim();
    let count = 0;
    tagItems.forEach((item) => {
      const visible = !query || (item.dataset.search ?? '').includes(query);
      item.hidden = !visible;
      if (visible) count += 1;
    });
    if (tagStatus) tagStatus.textContent = query ? `“${tagInput?.value.trim()}” · ${count} 个结果` : `${count} 个标签`;
    if (tagClear) tagClear.hidden = !query;
    if (tagEmpty) tagEmpty.hidden = count !== 0;
  };

  tagInput?.addEventListener('input', filterTags);
  tagClear?.addEventListener('click', () => {
    if (!tagInput) return;
    tagInput.value = '';
    tagInput.focus();
    filterTags();
  });
</script>

<style>
  .tags-page :global(.page-hero__aside strong) {
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .tag-explorer > header {
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--pad-x) 2rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .tag-explorer h2 {
    margin: 0.9rem 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .tag-explorer output {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .tag-search {
    min-height: 3.5rem;
    padding: 0 0.6rem 0 var(--pad-x);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    background: var(--panel);
    cursor: text;
  }

  .tag-search:focus-within {
    color: var(--accent);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .tag-search input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font-size: 1rem;
  }

  .tag-search input::placeholder {
    color: var(--ink-3);
  }

  .tag-search button[hidden] {
    display: none;
  }

  .tag-cloud {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .tag-cloud a {
    min-width: 0;
    min-height: 5.5rem;
    padding: 0.85rem 1rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 0.4rem;
    color: var(--ink);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .tag-cloud a:hover {
    color: var(--accent);
    background: var(--panel);
  }

  .tag-cloud a[hidden] { display: none; }

  .tag-cloud span {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .tag-cloud strong {
    min-width: 0;
    align-self: end;
    grid-column: 1 / -1;
    overflow: hidden;
    font-size: 0.9375rem;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-cloud sup {
    grid-column: 3;
    grid-row: 1;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .tag-empty {
    padding: 4rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-align: center;
  }

  .tag-empty[hidden] {
    display: none;
  }

  @media (max-width: 58rem) { .tag-cloud { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 40rem) {
    .tag-explorer > header { align-items: flex-start; flex-direction: column; }
    .tag-cloud { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tag-cloud a { min-height: 4.75rem; }
  }
</style>
