---
import { NAV, SITE } from '../consts';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const isCurrent = (href: string) => href === '/' ? normalizedPath === '/' : normalizedPath.startsWith(href);
---

<header class="site-header">
  <div class="header-wrapper">
    <a class="header-title" href="/" aria-label={`${SITE.title} 首页`} data-astro-prefetch="hover">{SITE.title}</a>

    <nav class="desktop-menu" aria-label="主导航">
      {NAV.map((item) => (
        <a class="menu-item" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-astro-prefetch="hover">
          {item.label}
        </a>
      ))}
      <a class="menu-icon" href="/rss.xml" aria-label="RSS" title="RSS"><Icon name="rss" size={18} /></a>
      <a class="menu-icon" href="https://github.com/zu1k" rel="me noopener" aria-label="GitHub" title="GitHub"><Icon name="github" size={18} /></a>
      <span class="menu-delimiter" aria-hidden="true"></span>
      <form class="header-search" action="/search/" role="search" data-header-search>
        <button type="button" class="header-search__toggle" aria-label="搜索" aria-expanded="false" data-header-search-toggle>
          <Icon name="search" size={18} />
        </button>
        <input
          name="q"
          type="search"
          aria-label="搜索文章标题或内容"
          aria-controls="header-search-results"
          aria-describedby="header-search-status"
          aria-expanded="false"
          placeholder="搜索文章标题或内容..."
          autocomplete="off"
          tabindex="-1"
          data-header-search-input
        />
        <div class="header-search__preview" aria-label="搜索建议" data-header-search-preview hidden>
          <div class="header-search__feedback">
            <span id="header-search-status" data-header-search-status aria-live="polite">输入关键词开始搜索</span>
            <button type="submit" class="header-search__enter"><kbd>↵</kbd> 查看全部</button>
          </div>
          <ol id="header-search-results" class="header-search__results" data-header-search-results></ol>
          <a class="header-search__all" href="/search/" data-header-search-all data-astro-prefetch="hover">
            <span>打开完整搜索</span><span aria-hidden="true">→</span>
          </a>
        </div>
      </form>
      <ThemeToggle />
    </nav>

    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="打开导航" aria-expanded="false" aria-controls="mobile-navigation" data-mobile-menu-summary>
        <span></span><span></span><span></span>
      </summary>
      <span class="mobile-menu__scrim" aria-hidden="true"></span>
      <div class="mobile-menu__panel" id="mobile-navigation">
        <header class="mobile-menu__heading" data-no-select>
          <span>NAVIGATION</span>
          <small>{String(NAV.length + 2).padStart(2, '0')} LINKS</small>
        </header>
        <form action="/search/" role="search">
          <Icon name="search" size={17} />
          <input name="q" type="search" aria-label="搜索文章标题或内容" placeholder="搜索文章标题或内容..." autocomplete="off" />
          <button type="submit" aria-label="提交搜索"><Icon name="arrow" size={15} /></button>
        </form>
        <nav aria-label="移动端主导航">
          {NAV.map((item, index) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-astro-prefetch="tap">
              <span class="mobile-menu__index" data-no-select>{String(index + 1).padStart(2, '0')}</span>
              <span>{item.label}</span>
              <span class="mobile-menu__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
          <a href="/rss.xml">
            <span class="mobile-menu__index" data-no-select>{String(NAV.length + 1).padStart(2, '0')}</span>
            <span>RSS</span>
            <span class="mobile-menu__arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://github.com/zu1k" rel="me noopener">
            <span class="mobile-menu__index" data-no-select>{String(NAV.length + 2).padStart(2, '0')}</span>
            <span>GitHub</span>
            <span class="mobile-menu__arrow" aria-hidden="true">↗</span>
          </a>
        </nav>
        <div class="mobile-menu__theme">
          <span><small>APPEARANCE</small><strong>页面主题</strong></span>
          <ThemeToggle />
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  type HeaderSearchItem = {
    title: string;
    url: string;
    date: string;
    timestamp: string;
    summary: string;
    content: string;
    tags: string[];
    categories: string[];
    categoryLabel: string;
  };

  const search = document.querySelector<HTMLFormElement>('[data-header-search]');
  const searchToggle = search?.querySelector<HTMLButtonElement>('[data-header-search-toggle]');
  const searchInput = search?.querySelector<HTMLInputElement>('[data-header-search-input]');
  const searchPreview = search?.querySelector<HTMLElement>('[data-header-search-preview]');
  const searchStatus = search?.querySelector<HTMLElement>('[data-header-search-status]');
  const searchResults = search?.querySelector<HTMLOListElement>('[data-header-search-results]');
  const searchAll = search?.querySelector<HTMLAnchorElement>('[data-header-search-all]');
  let searchIndexPromise: Promise<HeaderSearchItem[]> | undefined;

  const normalizeSearchText = (value: string) => value.normalize('NFKC').toLocaleLowerCase('zh-CN');

  const loadSearchIndex = () => {
    searchIndexPromise ??= fetch('/search-index.json')
      .then((response) => {
        if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
        return response.json() as Promise<HeaderSearchItem[]>;
      });
    return searchIndexPromise;
  };

  const setFullSearchUrl = (query: string) => {
    if (!searchAll) return;
    const url = new URL('/search/', location.origin);
    if (query) url.searchParams.set('q', query);
    searchAll.href = `${url.pathname}${url.search}`;
  };

  const renderSearchResults = (items: HeaderSearchItem[]) => {
    if (!searchResults) return;
    searchResults.replaceChildren();
    items.forEach((item, index) => {
      const row = document.createElement('li');
      const link = document.createElement('a');
      const serial = document.createElement('span');
      const body = document.createElement('span');
      const title = document.createElement('strong');
      const meta = document.createElement('small');
      const arrow = document.createElement('span');

      link.href = item.url;
      serial.className = 'header-search__serial';
      serial.textContent = String(index + 1).padStart(2, '0');
      body.className = 'header-search__result-body';
      title.textContent = item.title;
      meta.textContent = `${item.date} · ${item.categoryLabel || item.tags[0] || '文章'}`;
      arrow.className = 'header-search__result-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '↗';
      body.append(title, meta);
      link.append(serial, body, arrow);
      row.append(link);
      searchResults.append(row);
    });
  };

  const rankSearchItem = (item: HeaderSearchItem, query: string, tokens: string[]) => {
    const title = normalizeSearchText(item.title);
    const taxonomy = normalizeSearchText([...item.tags, ...item.categories, item.categoryLabel].join(' '));
    const summary = normalizeSearchText(item.summary);
    const content = normalizeSearchText(item.content);
    const searchable = `${title} ${taxonomy} ${summary} ${content}`;
    if (!tokens.every((token) => searchable.includes(token))) return -1;

    let score = 0;
    if (title === query) score += 120;
    else if (title.startsWith(query)) score += 90;
    else if (title.includes(query)) score += 70;
    if (taxonomy.includes(query)) score += 45;
    if (summary.includes(query)) score += 24;
    if (content.includes(query)) score += 10;
    return score;
  };

  const renderSearchPreview = async () => {
    if (!searchInput || !searchStatus) return;
    const rawQuery = searchInput.value.trim();
    const query = normalizeSearchText(rawQuery);
    setFullSearchUrl(rawQuery);
    if ([...query].length < 2) {
      renderSearchResults([]);
      searchStatus.textContent = rawQuery
        ? '再输入一个字符即可快速预览'
        : '输入至少 2 个字符 · 回车查看完整搜索';
      return;
    }

    searchStatus.textContent = '正在匹配本地文章索引…';
    try {
      const items = await loadSearchIndex();
      if (normalizeSearchText(searchInput.value.trim()) !== query) return;
      const tokens = query.split(/\s+/).filter(Boolean);
      const matches = items
        .map((item) => ({ item, score: rankSearchItem(item, query, tokens) }))
        .filter((match) => match.score >= 0)
        .sort((a, b) => b.score - a.score || Date.parse(b.item.timestamp) - Date.parse(a.item.timestamp));
      renderSearchResults(matches.slice(0, 5).map((match) => match.item));
      searchStatus.textContent = matches.length > 0
        ? `快速匹配到 ${matches.length} 篇文章${matches.length > 5 ? ' · 显示前 5 篇' : ''}`
        : '暂未直接匹配 · 回车尝试完整搜索';
    } catch {
      renderSearchResults([]);
      searchStatus.textContent = '快速预览暂不可用 · 回车仍可搜索';
    }
  };

  const closeSearch = () => {
    search?.classList.remove('is-open');
    searchToggle?.setAttribute('aria-expanded', 'false');
    searchPreview?.setAttribute('hidden', '');
    if (searchInput) {
      searchInput.tabIndex = -1;
      searchInput.setAttribute('aria-expanded', 'false');
    }
  };

  searchToggle?.addEventListener('click', () => {
    const open = !search?.classList.contains('is-open');
    search?.classList.toggle('is-open', open);
    searchToggle.setAttribute('aria-expanded', String(open));
    if (searchInput) {
      searchInput.tabIndex = open ? 0 : -1;
      searchInput.setAttribute('aria-expanded', String(open));
      if (open) {
        searchPreview?.removeAttribute('hidden');
        searchInput.focus();
        void renderSearchPreview();
      } else {
        searchPreview?.setAttribute('hidden', '');
      }
    }
  });

  searchInput?.addEventListener('input', () => void renderSearchPreview());
  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      search?.requestSubmit();
    }
  });

  search?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
    const links = [...(searchResults?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
    if (links.length === 0) return;
    event.preventDefault();
    const currentIndex = links.indexOf(document.activeElement as HTMLAnchorElement);
    const nextIndex = event.key === 'ArrowDown'
      ? (currentIndex + 1 + links.length) % links.length
      : (currentIndex <= 0 ? links.length - 1 : currentIndex - 1);
    links[nextIndex]?.focus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && search?.classList.contains('is-open')) {
      closeSearch();
      searchToggle?.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (search && event.target instanceof Node && !search.contains(event.target)) closeSearch();
  });

  const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  const mobileMenuSummary = mobileMenu?.querySelector<HTMLElement>('[data-mobile-menu-summary]');

  const closeMobileMenu = (restoreFocus = false) => {
    if (!mobileMenu?.open) return;
    mobileMenu.open = false;
    if (restoreFocus) mobileMenuSummary?.focus();
  };

  mobileMenu?.addEventListener('toggle', () => {
    const open = mobileMenu.open;
    mobileMenuSummary?.setAttribute('aria-expanded', String(open));
    mobileMenuSummary?.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
    document.documentElement.toggleAttribute('data-mobile-menu-open', open);
  });

  mobileMenu?.querySelectorAll<HTMLAnchorElement>('nav a').forEach((link) => {
    link.addEventListener('click', () => closeMobileMenu());
  });

  document.addEventListener('click', (event) => {
    if (mobileMenu?.open && event.target instanceof Node && !mobileMenu.contains(event.target)) {
      closeMobileMenu();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.open) closeMobileMenu(true);
  });

  const desktopMedia = window.matchMedia('(min-width: 60.001rem)');
  desktopMedia.addEventListener('change', (event) => {
    if (event.matches) closeMobileMenu();
  });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 150;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-h);
    color: var(--ink);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .header-wrapper {
    position: relative;
    width: var(--frame);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    border-inline: 1px solid var(--line);
  }

  /* "+" marks where the header rule meets the frame rails. */
  .header-wrapper::before,
  .header-wrapper::after {
    position: absolute;
    z-index: 2;
    bottom: -5px;
    width: 9px;
    height: 9px;
    content: "";
    background:
      linear-gradient(var(--mark), var(--mark)) center / 1px 100% no-repeat,
      linear-gradient(var(--mark), var(--mark)) center / 100% 1px no-repeat;
    pointer-events: none;
  }

  .header-wrapper::before { left: -5px; }
  .header-wrapper::after { right: -5px; }

  .header-title {
    min-width: 0;
    padding: 0 1.35rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-right: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-title:hover {
    color: var(--ink);
    background: var(--panel);
  }

  .desktop-menu {
    height: 100%;
    display: flex;
    align-items: stretch;
    white-space: nowrap;
  }

  .menu-item {
    position: relative;
    padding: 0 0.8rem;
    display: flex;
    align-items: center;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .menu-item::after {
    position: absolute;
    right: 0.8rem;
    bottom: -1px;
    left: 0.8rem;
    height: 2px;
    content: "";
    background: var(--line-strong);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .menu-item:hover {
    color: var(--ink);
  }

  .menu-item:hover::after {
    transform: scaleX(1);
  }

  .menu-item[aria-current="page"] {
    color: var(--ink);
  }

  .menu-item[aria-current="page"]::after {
    background: var(--accent);
    transform: scaleX(1);
  }

  .menu-item + .menu-icon {
    margin-left: 0.4rem;
    border-left: 1px solid var(--line);
  }

  .menu-icon {
    width: 2.75rem;
    display: grid;
    place-items: center;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .menu-icon:hover {
    color: var(--ink);
    background: var(--panel);
  }

  .menu-delimiter {
    width: 1px;
    align-self: stretch;
    background: var(--line);
  }

  .header-search {
    position: relative;
    height: 100%;
    padding-left: 0.5rem;
    display: flex;
    align-items: center;
  }

  .header-search__toggle {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--ink-2);
    background: transparent;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .header-search__toggle:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .header-search input {
    width: 0;
    min-width: 0;
    height: 2.25rem;
    padding: 0;
    border: 1px solid transparent;
    border-left: 0;
    border-radius: 0 var(--radius) var(--radius) 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    opacity: 0;
    transition: width 0.25s ease, padding 0.25s ease, opacity 0.2s ease;
  }

  .header-search input::placeholder {
    color: var(--ink-3);
  }

  .header-search.is-open .header-search__toggle {
    border-color: var(--line-strong);
    border-radius: var(--radius) 0 0 var(--radius);
    color: var(--ink);
    background: var(--panel);
  }

  .header-search.is-open input {
    width: min(16rem, 22vw);
    padding: 0 0.75rem 0 0.15rem;
    border-color: var(--line-strong);
    background: var(--panel);
    opacity: 1;
  }

  .header-search__preview {
    position: absolute;
    z-index: 4;
    top: 100%;
    right: 0;
    width: max(100%, 24rem);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    background: var(--bg);
    white-space: normal;
  }

  .header-search__preview[hidden] {
    display: none;
  }

  .header-search__feedback {
    min-height: 2.5rem;
    padding: 0.6rem 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .header-search__enter {
    padding: 0;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 0;
    color: var(--ink-2);
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .header-search__enter:hover,
  .header-search__enter:focus-visible {
    color: var(--accent);
    outline: 0;
  }

  .header-search__enter kbd {
    min-width: 1.3rem;
    padding: 0.1rem 0.3rem;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-mono);
    line-height: 1.2;
  }

  .header-search__results {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-search__results:empty {
    display: none;
  }

  .header-search__results :global(li + li) {
    border-top: 1px solid var(--line);
  }

  .header-search__results :global(a) {
    min-height: 3.6rem;
    padding: 0.6rem 0.85rem;
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .header-search__results :global(a:hover),
  .header-search__results :global(a:focus-visible) {
    outline: 0;
    background: var(--panel-2);
  }

  .header-search__results :global(a:focus-visible) {
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .header-search__results :global(.header-search__serial) {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .header-search__results :global(.header-search__result-body) {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
  }

  .header-search__results :global(.header-search__result-body strong) {
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-search__results :global(.header-search__result-body small) {
    overflow: hidden;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-search__results :global(.header-search__result-arrow) {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .header-search__results :global(a:hover .header-search__result-arrow),
  .header-search__results :global(a:focus-visible .header-search__result-arrow) {
    color: var(--accent);
  }

  .header-search__all {
    min-height: 2.6rem;
    padding: 0.6rem 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .header-search__all:hover,
  .header-search__all:focus-visible {
    color: var(--accent);
    outline: 0;
    background: var(--panel-2);
  }

  .desktop-menu > :global(.theme-toggle) {
    margin: auto 0.6rem auto 0.3rem;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 60rem) {
    .header-title {
      min-width: max-content;
      overflow: visible;
    }

    .desktop-menu {
      display: none;
    }

    .mobile-menu {
      position: relative;
      flex: none;
      display: block;
    }

    .mobile-menu > summary {
      position: relative;
      z-index: 3;
      width: var(--header-h);
      height: calc(var(--header-h) - 1px);
      display: grid;
      place-content: center;
      gap: 0.3rem;
      border-left: 1px solid var(--line);
      color: var(--ink);
      cursor: pointer;
      list-style: none;
      transition: background-color 0.15s ease;
    }

    .mobile-menu > summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu > summary span {
      width: 1.1rem;
      height: 1px;
      display: block;
      background: currentColor;
      transition: transform 0.25s ease, opacity 0.2s ease;
    }

    .mobile-menu > summary:hover,
    .mobile-menu > summary:focus-visible,
    .mobile-menu[open] > summary {
      outline: 0;
      background: var(--panel);
    }

    .mobile-menu > summary:focus-visible {
      box-shadow: inset 0 0 0 2px var(--accent);
    }

    .mobile-menu[open] > summary span:nth-child(1) { transform: translateY(calc(0.3rem + 1px)) rotate(45deg); }
    .mobile-menu[open] > summary span:nth-child(2) { opacity: 0; }
    .mobile-menu[open] > summary span:nth-child(3) { transform: translateY(calc(-0.3rem - 1px)) rotate(-45deg); }

    .mobile-menu__scrim {
      position: fixed;
      z-index: 0;
