---
export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  mark?: string | number;
  compact?: boolean;
}

const { eyebrow, title, description, mark = '/', compact = false } = Astro.props;
const [eyebrowHead, ...eyebrowRest] = eyebrow.split(' / ');
---

<header class:list={['page-hero', { 'page-hero--compact': compact }]}>
  <div class="page-hero__copy">
    <p class="page-hero__eyebrow" data-no-select>
      <b>{eyebrowHead}</b>{eyebrowRest.length > 0 && <span> / {eyebrowRest.join(' / ')}</span>}
    </p>
    <h1 data-no-select>{title}</h1>
    {description && <p class="page-hero__description">{description}</p>}
    <div class="page-hero__actions"><slot name="actions" /></div>
  </div>
  <div class="page-hero__panel">
    <span class="page-hero__mark" aria-hidden="true">{mark}</span>
    <div class="page-hero__aside"><slot name="aside" /></div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.52fr);
    border-bottom: 1px solid var(--line);
  }

  .page-hero__copy {
    min-width: 0;
    padding: clamp(2.6rem, 6vw, 4.4rem) var(--pad) clamp(2rem, 4vw, 2.8rem);
  }

  .page-hero__eyebrow {
    margin: 0 0 1.1rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .page-hero__eyebrow b {
    color: var(--accent);
    font-weight: 500;
  }

  h1 {
    max-width: 15ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.4vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .page-hero__description {
    max-width: 34rem;
    margin: 1.2rem 0 0;
    color: var(--ink-2);
    font-size: 0.8rem;
    line-height: 1.85;
  }

  .page-hero__actions:empty,
  .page-hero__aside:empty {
    display: none;
  }

  .page-hero__actions {
    margin-top: 1.4rem;
  }

  .page-hero__panel {
    position: relative;
    min-width: 0;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1rem;
    border-left: 1px solid var(--line);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 1.2rem 1.2rem,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 1.2rem 1.2rem,
      var(--panel);
  }

  .page-hero__mark {
    position: absolute;
    top: 0.9rem;
    right: 1.1rem;
    color: var(--ink);
    font-family: var(--font-code);
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .page-hero__mark::before {
    position: absolute;
    top: 0.2rem;
    right: calc(100% + 0.6rem);
    color: var(--ink-3);
    content: "FIG.";
    font-size: 0.54rem;
    letter-spacing: 0.12em;
  }

  .page-hero__aside {
    position: relative;
    z-index: 1;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
    background: var(--bg);
    font-size: 0.68rem;
    line-height: 1.75;
  }

  .page-hero__aside :global(strong) {
    color: var(--ink);
    font-family: var(--font-code);
    font-weight: 500;
  }

  .page-hero--compact .page-hero__copy {
    padding-top: clamp(2.4rem, 5vw, 3.6rem);
  }

  .page-hero--compact h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
  }

  @media (max-width: 60rem) {
    .page-hero__eyebrow { font-size: 0.66rem; }
    .page-hero__description { font-size: 0.95rem; }
    .page-hero__aside { font-size: 0.82rem; }
    .page-hero__mark::before { font-size: 0.62rem; }
  }

  @media (max-width: 48rem) {
    .page-hero {
      grid-template-columns: 1fr;
    }

    .page-hero__copy {
      padding: 2.4rem var(--pad) 1.8rem;
    }

    h1,
    .page-hero--compact h1 {
      max-width: none;
      font-size: clamp(2.2rem, 10vw, 3rem);
    }

    .page-hero__panel {
      min-height: 6.5rem;
      padding: var(--pad);
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .page-hero__mark {
      top: 0.8rem;
      right: var(--pad);
      font-size: 3rem;
    }

    .page-hero__aside {
      max-width: calc(100% - 6rem);
    }
  }
</style>
