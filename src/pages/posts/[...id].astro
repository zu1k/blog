---
import { render } from 'astro:content';
import ArticleChrome from '../../components/ArticleChrome.astro';
import ArticleEnhancements from '../../features/ArticleEnhancements.astro';
import Comments from '../../features/Comments.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getAdjacentPosts,
  getExcerpt,
  getPostSlug,
  getPostUrl,
  getPublishedPosts,
  getReadingTime,
  normalizeTaxonomy,
} from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts({ includeDrafts: !import.meta.env.PROD });
  return posts.map((post) => ({
    params: { id: getPostSlug(post) },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const description = post.data.description || post.data.summary || getExcerpt(post, 180);
const reading = getReadingTime(post);
const categories = normalizeTaxonomy(post.data.categories);
const tags = normalizeTaxonomy(post.data.tags);
const adjacent = getAdjacentPosts(posts, post);
const hasMermaid = Boolean(post.data.mermaid || post.body?.includes('```mermaid'));
const commentsEnabled = post.data.comment !== false;
---

<BaseLayout
  title={post.data.title}
  description={description}
  type="article"
  publishedTime={post.data.date}
  canonical={getPostUrl(post)}
>
  <ArticleChrome
    title={post.data.title}
    description={description}
    date={post.data.date}
    readingTime={reading.minutes}
    wordCount={reading.words}
    categories={categories}
    tags={tags}
    headings={headings}
    toc={post.data.toc !== false}
  >
    <Content />
  </ArticleChrome>

  <nav class="post-nav" aria-label="相邻文章">
    {adjacent.previous ? (
      <a class="post-nav__older" href={getPostUrl(adjacent.previous)}>
        <span>← 上一篇 / OLDER</span>
        <strong>{adjacent.previous.data.title}</strong>
      </a>
    ) : <span></span>}
    {adjacent.next && (
      <a class="post-nav__newer" href={getPostUrl(adjacent.next)}>
        <span>下一篇 / NEWER →</span>
        <strong>{adjacent.next.data.title}</strong>
      </a>
    )}
  </nav>

  {commentsEnabled && <Comments title={post.data.title} />}
  <ArticleEnhancements mermaid={hasMermaid} />
</BaseLayout>

<style>
  .post-nav {
    width: var(--frame);
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .post-nav a,
  .post-nav > span {
    min-height: 6.2rem;
    padding: 1.1rem var(--pad) 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .post-nav > :first-child {
    border-right: 1px solid var(--line);
  }

  .post-nav a > span {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
  }

  .post-nav strong {
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .post-nav__newer {
    align-items: flex-end;
    text-align: right;
  }

  .post-nav a:hover {
    background: var(--panel);
  }

  .post-nav a:hover strong,
  .post-nav a:hover > span {
    color: var(--accent);
  }

  @media (max-width: 60rem) {
    .post-nav a > span { font-size: 0.64rem; }
  }

  @media (max-width: 48rem) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav > :first-child {
      border-right: 0;
    }

    .post-nav a + a {
      border-top: 1px solid var(--line);
    }

    .post-nav > span:empty {
      display: none;
    }
  }
</style>
