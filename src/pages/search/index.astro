---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="搜索 zu1k 博客的标题、正文、分类与标签。" noindex={true}>
  <div class="wide-page search-page">
    <PageHero
      eyebrow="FULL TEXT / LOCAL INDEX"
      title="搜索"
      description="标题、正文、分类和标签都在本地浏览器中完成匹配。输入一个概念、一项技术，或者记忆中的半句话。"
      mark="?"
      compact
    >
      <div slot="aside">无需上传搜索内容<br />索引覆盖全部公开文章</div>
    </PageHero>

    <section class="search-workspace" aria-labelledby="search-workspace-title">
      <h2 id="search-workspace-title" class="visually-hidden">全文搜索</h2>
      <form class="search-box" role="search" data-search-form>
        <label class="visually-hidden" for="search-input">搜索全部文章</label>
        <Icon name="search" size={23} />
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="搜索技术、概念或一句话…"
          autocomplete="off"
          autofocus
          data-search-input
        />
        <kbd>ESC</kbd>
      </form>

      <div class="search-status" data-search-status aria-live="polite">正在准备索引…</div>
      <ol class="search-results" data-search-results></ol>
      <noscript><p>全文搜索需要 JavaScript。你仍然可以从<a href="/posts/">文章归档</a>浏览。</p></noscript>
    </section>
  </div>
</BaseLayout>

<script>
  import Fuse from 'fuse.js';

  type SearchItem = {
    title: string;
    url: string;
    date: string;
    summary: string;
    content: string;
    tags: string[];
    categories: string[];
    categoryLabel: string;
    readingTime: number;
  };

  const form = document.querySelector<HTMLFormElement>('[data-search-form]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const results = document.querySelector<HTMLOListElement>('[data-search-results]');
  const response = await fetch('/search-index.json');
  const items: SearchItem[] = await response.json();
  const fuse = new Fuse(items, {
    includeScore: true,
    ignoreLocation: true,
    minMatchCharLength: 2,
    threshold: 0.34,
    keys: [
      { name: 'title', weight: 0.42 },
      { name: 'tags', weight: 0.2 },
      { name: 'categories', weight: 0.14 },
      { name: 'summary', weight: 0.14 },
      { name: 'content', weight: 0.1 },
    ],
  });

  const addText = (element: HTMLElement, value: string) => {
    element.textContent = value;
    return element;
  };

  const render = (query: string) => {
    if (!results || !status) return;
    results.replaceChildren();
    const normalized = query.trim();
    if (normalized.length < 2) {
      status.textContent = `索引已就绪：${items.length} 篇公开文章。请输入至少 2 个字符。`;
      return;
    }

    const matches = fuse.search(normalized, { limit: 24 });
    status.textContent = matches.length > 0
      ? `“${normalized}” · ${matches.length} 个相关结果`
      : '没有找到相关文章，试试更短或更具体的关键词。';

    matches.forEach(({ item }, index) => {
      const row = document.createElement('li');
      const link = document.createElement('a');
      link.href = item.url;
      const serial = addText(document.createElement('span'), String(index + 1).padStart(2, '0'));
      serial.className = 'result-serial';
      const body = document.createElement('span');
      body.className = 'result-body';
      const title = addText(document.createElement('strong'), item.title);
      const summary = addText(document.createElement('small'), item.summary);
      body.append(title, summary);
      const meta = addText(
        document.createElement('span'),
        `${item.date}  /  ${item.readingTime} MIN  /  ${item.categoryLabel || item.tags[0] || '文章'}`,
      );
      meta.className = 'result-meta';
      const arrow = addText(document.createElement('span'), '↗');
      arrow.className = 'result-arrow';
      link.append(serial, body, meta, arrow);
      row.append(link);
      results.append(row);
    });
  };

  const params = new URLSearchParams(location.search);
  const initial = params.get('q') ?? '';
  if (input) input.value = initial;
  render(initial);

  form?.addEventListener('submit', (event) => event.preventDefault());
  input?.addEventListener('input', () => {
    const query = input.value;
    const url = new URL(location.href);
    query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
    history.replaceState({}, '', url);
    render(query);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && input) {
      input.value = '';
      input.focus();
      render('');
    }
  });
</script>

<style>
  .search-workspace {
    padding: 2rem var(--pad) 1rem;
  }

  .search-box {
    min-height: 4.2rem;
    padding: 0 0.9rem 0 1.1rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    color: var(--ink-3);
    background: var(--panel);
    box-shadow: 0.3rem 0.3rem 0 color-mix(in srgb, var(--ink) 7%, transparent);
    transition: box-shadow 0.2s ease;
  }

  .search-box:focus-within {
    color: var(--accent);
    box-shadow: inset 3px 0 0 var(--accent), 0.3rem 0.3rem 0 color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .search-box input {
    min-width: 0;
    padding: 0.8rem 0;
    border: 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.8rem);
    letter-spacing: -0.01em;
  }

  .search-box input::placeholder { color: var(--ink-3); }
  .search-box input::-webkit-search-cancel-button { display: none; }

  .search-box kbd {
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-code);
    font-size: 0.52rem;
  }

  .search-status {
    min-height: 2.6rem;
    padding: 0.9rem 0 0.7rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.56rem;
    letter-spacing: 0.02em;
  }

  .search-results {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .search-results:empty {
    border-top-color: var(--line);
  }

  .search-results :global(a) {
    min-height: 4.6rem;
    padding: 0.85rem 0.5rem;
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    transition: background-color 0.15s ease;
  }

  .search-results :global(a:hover),
  .search-results :global(a:focus-visible) {
    outline: 0;
    background: var(--panel);
  }

  .search-results :global(.result-serial),
  .search-results :global(.result-meta) {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.52rem;
    letter-spacing: 0.04em;
    white-space: pre;
  }

  .search-results :global(.result-serial) { color: var(--accent); }

  .search-results :global(.result-body) {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .search-results :global(.result-body strong) {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .search-results :global(a:hover .result-body strong) {
    color: var(--accent);
  }

  .search-results :global(.result-body small) {
    margin-top: 0.25rem;
    overflow: hidden;
    color: var(--ink-2);
    font-size: 0.64rem;
    line-height: 1.55;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-results :global(.result-arrow) {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.66rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .search-results :global(a:hover .result-arrow) {
    color: var(--accent);
    transform: translate(0.12rem, -0.12rem);
  }

  @media (max-width: 60rem) {
    .search-box kbd,
    .search-status { font-size: 0.66rem; }
    .search-results :global(.result-serial),
    .search-results :global(.result-meta) { font-size: 0.64rem; }
    .search-results :global(.result-body small) { font-size: 0.82rem; }
  }

  @media (max-width: 48rem) {
    .search-workspace { padding-top: 1.4rem; }
    .search-box { min-height: 3.6rem; padding-inline: 0.8rem; }
    .search-box input { font-size: 1.2rem; }
    .search-box kbd { display: none; }
    .search-results :global(a) { grid-template-columns: 1.5rem minmax(0, 1fr) auto; gap: 0.2rem 0.65rem; padding-inline: 0; }
    .search-results :global(.result-meta) { grid-column: 2; white-space: normal; }
    .search-results :global(.result-arrow) { grid-row: 1 / span 2; grid-column: 3; }
  }
</style>
