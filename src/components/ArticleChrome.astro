---
import TableOfContents, { type TocHeading } from './TableOfContents.astro';
import Icon from './Icon.astro';
import { formatDate, getTaxonomyLabel, getTaxonomyUrl, toDate } from '../lib/content';

export interface Props {
  title: string;
  description?: string;
  date?: Date | string;
  updated?: Date | string;
  readingTime?: number | string;
  wordCount?: number;
  categories?: string[];
  tags?: string[];
  headings?: TocHeading[];
  toc?: boolean;
}

const {
  title,
  description,
  date,
  updated,
  readingTime,
  wordCount,
  categories = [],
  tags = [],
  headings = [],
  toc = true,
} = Astro.props;

const validDate = date ? toDate(date) : undefined;
const validUpdated = updated ? toDate(updated) : undefined;
const dateText = validDate && !Number.isNaN(validDate.valueOf()) ? formatDate(validDate, 'short') : undefined;
const updatedText = validUpdated && !Number.isNaN(validUpdated.valueOf()) ? formatDate(validUpdated, 'short') : undefined;
const readText = typeof readingTime === 'number' ? `阅读 ${Math.max(1, Math.round(readingTime))} 分钟` : readingTime;
const showToc = toc && headings.some((heading) => heading.depth === 2 || heading.depth === 3);
---

<article class:list={['article', { 'article--has-toc': showToc }]}>
  <header class="article-header">
    <div class="article-header__rail">
      <p class="article-kicker" data-no-select><b>WRITING</b> / {categories[0] ? getTaxonomyLabel('categories', categories[0]).toLocaleUpperCase('zh-CN') : 'NOTE'}</p>
      {(dateText || wordCount || readText || updatedText) && (
        <dl class="article-meta">
          {dateText && <div><dt><Icon name="calendar" size={12} /> 发布</dt><dd><time datetime={validDate?.toISOString()}>{dateText}</time></dd></div>}
          {updatedText && <div><dt>更新于</dt><dd>{updatedText}</dd></div>}
          {typeof wordCount === 'number' && <div><dt>✎ 字数</dt><dd>约 {wordCount} 字</dd></div>}
          {readText && <div><dt><Icon name="clock" size={12} /> 阅读</dt><dd>{readText.replace(/^阅读\s*/, '')}</dd></div>}
        </dl>
      )}
    </div>
    <div class="article-header__main">
      <h1>{title}</h1>
      {description && <p class="article-dek">{description}</p>}
      {categories.length > 0 && (
        <div class="article-categories">
          <span>收录于</span>
          {categories.map((category) => (
            <a href={getTaxonomyUrl('categories', category)}><Icon name="folder" size={13} /> {getTaxonomyLabel('categories', category)}</a>
          ))}
        </div>
      )}
    </div>
  </header>

  {showToc && <TableOfContents headings={headings} />}
  <div class="article-body prose"><slot /></div>

  {tags.length > 0 && (
    <footer class="article-footer">
      <span>标签：</span>
      {tags.map((tag, index) => (
        <><a href={getTaxonomyUrl('tags', tag)}>{getTaxonomyLabel('tags', tag)}</a>{index < tags.length - 1 && <span>, </span>}</>
      ))}
    </footer>
  )}
</article>

<style>
  .article {
    position: relative;
    width: var(--frame);
    max-width: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    align-items: start;
  }

  /* Rail divider runs the full length of the article. */
  .article::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--rail);
    width: 1px;
    content: "";
    background: var(--line);
    pointer-events: none;
  }

  .article-header {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .article-header__rail {
    min-width: 0;
    padding: clamp(2.6rem, 5vw, 3.8rem) 1.1rem 1.6rem;
  }

  .article-kicker {
    margin: 0 0 1.1rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.54rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.5;
  }

  .article-kicker b {
    display: block;
    color: var(--accent);
    font-weight: 500;
  }

  .article-meta {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }

  .article-meta > div {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--line);
  }

  .article-meta dt {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
  }

  .article-meta dd {
    margin: 0.1rem 0 0;
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
  }

  .article-header__main {
    min-width: 0;
    padding: clamp(2.6rem, 5vw, 3.8rem) var(--pad) 1.9rem;
  }

  .article-header h1 {
    max-width: 22ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.4vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .article-dek {
    max-width: 36rem;
    margin: 1.15rem 0 0;
    color: var(--ink-2);
    font-size: 0.8rem;
    line-height: 1.85;
  }

  .article-categories {
    margin-top: 1.3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.54rem;
    letter-spacing: 0.04em;
  }

  .article-categories a {
    padding: 0.12rem 0.45rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--ink-2);
    background: var(--panel);
  }

  .article-categories a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .article-body {
    grid-column: 2;
    min-width: 0;
    max-width: calc(40rem + 2 * var(--pad));
    padding: 2.2rem var(--pad) 1rem;
  }

  .article-footer {
    grid-column: 2;
    max-width: 40rem;
    margin: 1.5rem var(--pad) 0;
    padding: 0.8rem 0;
    border-block: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.56rem;
    letter-spacing: 0.03em;
  }

  .article-footer a {
    color: var(--ink);
  }

  .article-footer a:hover { color: var(--accent); }

  @media (max-width: 60rem) {
    .article-kicker,
    .article-categories,
    .article-footer { font-size: 0.66rem; }
    .article-meta dt { font-size: 0.6rem; }
    .article-meta dd { font-size: 0.74rem; }
    .article-dek { font-size: 0.98rem; }
  }

  @media (max-width: 48rem) {
    .article {
      grid-template-columns: minmax(0, 1fr);
    }

    .article::before {
      display: none;
    }

    .article-header {
      grid-template-columns: minmax(0, 1fr);
    }

    .article-header__rail {
      order: 2;
      padding: 0 var(--pad) 1.2rem;
    }

    .article-header__main {
      padding: 2.4rem var(--pad) 1.2rem;
    }

    .article-kicker {
      display: none;
    }

    .article-meta {
      grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
      gap: 0 1rem;
    }

    .article-header h1 {
      font-size: clamp(1.9rem, 8.5vw, 2.5rem);
    }

    .article-body,
    .article-footer {
      grid-column: 1;
    }

    .article-body {
      padding-top: 1.4rem;
    }
  }
</style>
