---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import friends from '../../data/friends';
import { siteIdentity } from '../../data/identity';

const siteExchangeInfo = `NAME: ${siteIdentity.name}\nBIO: ${siteIdentity.description}\nURL: ${siteIdentity.url}\nLOGO: ${siteIdentity.logo}`;
---

<BaseLayout title="友情链接" description="友情链接，欢迎与我交换友链。">
  <div class="wide-page links-page">
    <PageHero
      eyebrow="PEERS / OPEN WEB"
      title="友邻网站"
      description="独立网站让互联网保留了人的气味。这些是我在开放网络里遇见，并愿意反复拜访的朋友与同行者。"
      mark={friends.length}
      compact
    >
      <div slot="aside" class="site-card">
        <span>本站信息</span>
        <img src="/images/logo.jpg" alt="" width="48" height="48" />
        <div>
          <strong>{siteIdentity.name}</strong>
          <code>{siteIdentity.url}</code>
        </div>
        <p>{siteIdentity.description}</p>
        <button type="button" class="btn btn--sm" data-copy-site-info={siteExchangeInfo}>复制站点信息</button>
      </div>
    </PageHero>

    <section class="friend-directory band" aria-labelledby="friend-directory-title">
      <header>
        <div>
          <p class="eyebrow" data-no-select><b>01</b> / PEOPLE BEHIND THE LINKS</p>
          <h2 id="friend-directory-title">网络同行者</h2>
        </div>
        <span>{String(friends.length).padStart(2, '0')} FRIENDS</span>
      </header>

      <div class="friend-grid cells cells--open">
        {friends.map((friend, index) => (
          <a href={friend.url} rel="friend noopener" target="_blank">
            <span class="friend-index" data-no-select>{String(index + 1).padStart(2, '0')}</span>
            <img src={friend.avatar} alt="" width="96" height="96" loading="lazy" />
            <span class="friend-copy">
              <strong>{friend.name}</strong>
              <small>{friend.description}</small>
              <code>{new URL(friend.url).hostname}</code>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </section>

    <section class="exchange-note band split" aria-labelledby="exchange-title">
      <header class="split__rail">
        <p class="eyebrow" data-no-select><b>02</b> / EXCHANGE</p>
        <h2 id="exchange-title" class="rail-title">也欢迎你来敲门。</h2>
      </header>
      <div class="split__body">
        <p>如果你也在认真维护自己的独立网站，可以通过邮件发送网站名称、简介、地址与头像。</p>
        <a class="btn btn--primary" href="mailto:i@zu1k.com">i@zu1k.com <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const copySiteButton = document.querySelector<HTMLButtonElement>('[data-copy-site-info]');
  copySiteButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copySiteButton.dataset.copySiteInfo ?? '');
      copySiteButton.textContent = '已复制';
      setTimeout(() => { copySiteButton.textContent = '复制站点信息'; }, 1600);
    } catch {
      copySiteButton.textContent = '复制失败';
    }
  });
</script>

<style>
  .site-card {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem 0.8rem;
  }

  .site-card > span {
    grid-column: 1 / -1;
    margin-bottom: 0.2rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .site-card img {
    width: 3rem;
    height: 3rem;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    object-fit: cover;
  }

  .site-card > div { min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }

  .site-card strong {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .site-card code {
    overflow: hidden;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-card p {
    grid-column: 1 / -1;
    margin: 0.3rem 0 0;
    color: var(--ink-2);
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.5;
  }

  .site-card button {
    grid-column: 1 / -1;
    width: max-content;
    margin-top: 0.5rem;
  }

  .friend-directory > header {
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--pad-x) 2rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .friend-directory h2 {
    margin: 0.9rem 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .friend-directory > header > span {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .friend-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .friend-grid > a {
    position: relative;
    min-width: 0;
    min-height: 8.5rem;
    padding: 1.25rem var(--pad-x);
    display: grid;
    grid-template-columns: auto 4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    color: var(--ink);
    transition: background-color 0.15s ease;
  }

  .friend-grid > a:hover { background: var(--panel); }

  .friend-index {
    align-self: start;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .friend-grid img {
    width: 4rem;
    height: 4rem;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    object-fit: cover;
    filter: saturate(0.8);
    transition: filter 0.25s ease;
  }

  .friend-grid > a:hover img {
    filter: saturate(1);
  }

  .friend-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .friend-copy strong {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .friend-copy small {
    margin-top: 0.3rem;
    overflow: hidden;
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-copy code {
    margin-top: 0.55rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .friend-grid > a:hover .friend-copy strong {
    color: var(--accent);
  }

  .friend-grid :global(.icon) {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-0.25rem);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .friend-grid > a:hover :global(.icon) {
    opacity: 1;
    transform: translateX(0);
  }

  .exchange-note .split__body p {
    max-width: 36rem;
    margin: 0 0 1.25rem;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.75;
  }

  .exchange-note .split__body a {
    font-family: var(--font-mono);
  }

  @media (max-width: 46rem) {
    .friend-directory > header { align-items: flex-start; flex-direction: column; }
    .friend-grid { grid-template-columns: 1fr; }
    .friend-grid > a { min-height: 7.5rem; grid-template-columns: auto 3.4rem minmax(0, 1fr) auto; gap: 0.8rem; }
    .friend-grid img { width: 3.4rem; height: 3.4rem; }
  }
</style>
