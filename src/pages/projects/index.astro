---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { PROJECTS, PROJECT_CATEGORY_LABELS, PROJECT_FILTERS } from '../../data/projects';

const trendingCount = PROJECTS.filter((project) => project.trending).length;
const categoryCount = new Set(PROJECTS.map((project) => project.category)).size;
---

<BaseLayout title="我的项目" description="zu1k 的开源项目、开发工具与技术实验。">
  <div class="projects-page" data-projects>
    <section class="projects-hero" aria-labelledby="projects-title">
      <div class="projects-hero__copy">
        <p class="projects-kicker eyebrow" data-no-select>PROJECT INDEX · 2017—NOW</p>
        <h1 id="projects-title" data-no-select>从一个问题，<br /><em>到一个可用的工具。</em></h1>
        <p class="projects-intro">
          我喜欢把真实遇到的问题做成小而锋利的工具。这里收录网络、系统、安全和开源生态中的长期作品与阶段性实验。
        </p>
        <div class="projects-actions" data-no-select>
          <a class="projects-action projects-action--primary btn btn--primary" href="#project-explorer">
            浏览项目 <Icon name="arrow" size={17} />
          </a>
          <a class="projects-action btn" href="https://github.com/zu1k" rel="me noopener" target="_blank">
            <Icon name="github" size={17} /> GitHub
          </a>
        </div>
      </div>

      <dl class="projects-stats blueprint" aria-label="项目概览" data-no-select>
        <div>
          <dt>收录项目</dt>
          <dd>{PROJECTS.length}<small>个</small></dd>
        </div>
        <div>
          <dt>GitHub Trending</dt>
          <dd>{trendingCount}<small>次</small></dd>
        </div>
        <div>
          <dt>探索领域</dt>
          <dd>{categoryCount}<small>类</small></dd>
        </div>
      </dl>
    </section>

    <section class="project-explorer band" id="project-explorer" aria-labelledby="project-explorer-title">
      <header class="project-explorer__header">
        <div>
          <p class="projects-kicker eyebrow" data-no-select><b>01</b> / BROWSE THE WORK</p>
          <h2 id="project-explorer-title">项目浏览器</h2>
        </div>
        <p>按名称、技术或领域快速筛选。按 <kbd>/</kbd> 可以随时开始搜索。</p>
      </header>

      <div class="project-toolbar">
        <label class="project-search" for="project-search-input">
          <Icon name="search" size={18} />
          <span class="visually-hidden">搜索项目</span>
          <input
            id="project-search-input"
            type="search"
            placeholder="搜索项目、技术或关键词…"
            autocomplete="off"
            data-project-search
          />
          <kbd aria-hidden="true">/</kbd>
        </label>

        <div class="project-filters" role="group" aria-label="项目类型">
          {PROJECT_FILTERS.map((filter, index) => (
            <button type="button" data-project-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {filter.label}
            </button>
          ))}
        </div>
      </div>

      <div class="project-results-meta">
        <output data-project-status aria-live="polite">显示全部 {PROJECTS.length} 个项目</output>
        <button type="button" class="btn btn--sm" data-project-clear hidden>清除筛选</button>
      </div>

      <div class="project-grid cells cells--open" data-project-grid>
        {PROJECTS.map((project, index) => {
          const primaryLink = project.links[0];
          const searchText = [
            project.name,
            project.summary,
            PROJECT_CATEGORY_LABELS[project.category],
            ...project.stack,
          ].join(' ').normalize('NFKC').toLocaleLowerCase('zh-CN');
          return (
            <article
              class:list={['project-card', { 'is-featured': project.featured, 'is-trending': project.trending }]}
              data-project-card
              data-category={project.category}
              data-trending={project.trending ? 'true' : 'false'}
              data-search={searchText}
            >
              <div class="project-card__topline">
                <span class="project-card__index" data-no-select>{String(index + 1).padStart(2, '0')}</span>
                {project.trending && <span class="project-card__trending">↗ GitHub Trending</span>}
              </div>

              <h3>
                <a
                  href={primaryLink.href}
                  target={primaryLink.href.startsWith('http') ? '_blank' : undefined}
                  rel={primaryLink.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {project.name}<Icon name="arrow" size={18} />
                </a>
              </h3>
              <p>{project.summary}</p>
              {project.highlight && <strong class="project-card__highlight">{project.highlight}</strong>}

              <ul class="project-card__stack" aria-label="技术标签">
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>

              <footer>
                <span>{PROJECT_CATEGORY_LABELS[project.category]}</span>
                <nav aria-label={`${project.name} 链接`}>
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target={link.href.startsWith('http') ? '_blank' : undefined}
                      rel={link.href.startsWith('http') ? 'noopener' : undefined}
                    >
                      {link.label}<span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </nav>
              </footer>
            </article>
          );
        })}
      </div>

      <div class="project-empty" data-project-empty hidden>
        <span aria-hidden="true">∅</span>
        <h3>没有匹配的项目</h3>
        <p>换一个关键词，或者清除当前筛选条件。</p>
      </div>
      <noscript><p class="project-noscript">筛选功能需要 JavaScript；当前已展示全部项目。</p></noscript>
    </section>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-projects]');
  const searchInput = root?.querySelector<HTMLInputElement>('[data-project-search]');
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-project-card]') ?? [])];
  const filters = [...(root?.querySelectorAll<HTMLButtonElement>('[data-project-filter]') ?? [])];
  const status = root?.querySelector<HTMLOutputElement>('[data-project-status]');
  const clearButton = root?.querySelector<HTMLButtonElement>('[data-project-clear]');
  const empty = root?.querySelector<HTMLElement>('[data-project-empty]');
  const availableFilters = new Set(filters.map((button) => button.dataset.projectFilter ?? ''));
  const params = new URLSearchParams(location.search);
  let activeFilter = availableFilters.has(params.get('filter') ?? '') ? params.get('filter')! : 'all';
  let query = params.get('q') ?? '';

  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('zh-CN').trim();

  const renderProjects = () => {
    const normalizedQuery = normalize(query);
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatch = activeFilter === 'all'
        || card.dataset.category === activeFilter
        || (activeFilter === 'trending' && card.dataset.trending === 'true');
      const queryMatch = !normalizedQuery || (card.dataset.search ?? '').includes(normalizedQuery);
      const visible = categoryMatch && queryMatch;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    filters.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === activeFilter));
    });

    if (status) {
      const qualifier = normalizedQuery ? `“${query.trim()}”` : filters.find((button) => button.dataset.projectFilter === activeFilter)?.textContent?.trim();
      status.textContent = activeFilter === 'all' && !normalizedQuery
        ? `显示全部 ${visibleCount} 个项目`
        : `${qualifier || '当前条件'} · ${visibleCount} 个结果`;
    }

    if (empty) empty.hidden = visibleCount !== 0;
    if (clearButton) clearButton.hidden = activeFilter === 'all' && !normalizedQuery;

    const nextUrl = new URL(location.href);
    activeFilter === 'all' ? nextUrl.searchParams.delete('filter') : nextUrl.searchParams.set('filter', activeFilter);
    normalizedQuery ? nextUrl.searchParams.set('q', query.trim()) : nextUrl.searchParams.delete('q');
    history.replaceState({}, '', nextUrl);
  };

  if (searchInput) searchInput.value = query;
  renderProjects();

  filters.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.projectFilter ?? 'all';
    renderProjects();
  }));

  searchInput?.addEventListener('input', () => {
    query = searchInput.value;
    renderProjects();
  });

  clearButton?.addEventListener('click', () => {
    activeFilter = 'all';
    query = '';
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    renderProjects();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement;
    if (event.key === '/' && !isTyping && !event.metaKey && !event.ctrlKey && !event.altKey) {
      event.preventDefault();
      searchInput?.focus();
    }
  });
</script>

<style>
  .projects-page {
    width: 100%;
  }

  .projects-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
  }

  .projects-hero__copy {
    min-width: 0;
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad-x) clamp(2.75rem, 5vw, 4rem);
  }

  .projects-kicker {
    margin-bottom: 1.6rem;
  }

  .projects-hero .projects-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-2);
  }

  .projects-hero .projects-kicker::before {
    width: 7px;
    height: 7px;
    flex: none;
    content: "";
    background: var(--accent);
  }

  .projects-hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.6rem, 5.6vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .projects-hero h1 em {
    display: inline-block;
    color: var(--ink-2);
    font-style: normal;
    font-weight: 400;
    white-space: nowrap;
  }

  .projects-intro {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .projects-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .projects-stats {
    position: relative;
    min-width: 0;
    margin: 0;
    padding: 3rem var(--pad-x) var(--pad-x);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-left: 1px solid var(--line);
  }

  .projects-stats::before,
  .projects-stats::after {
    position: absolute;
    z-index: 3;
    left: -5px;
    width: 9px;
    height: 9px;
    content: "";
    background:
      linear-gradient(var(--mark), var(--mark)) center / 1px 100% no-repeat,
      linear-gradient(var(--mark), var(--mark)) center / 100% 1px no-repeat;
    pointer-events: none;
  }

  .projects-stats::before { top: -5px; }
  .projects-stats::after { bottom: -5px; }

  .projects-stats div {
    padding: 0.85rem 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .projects-stats div:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .projects-stats dt {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .projects-stats dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
  }

  .projects-stats small {
    margin-left: 0.2rem;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .project-explorer {
    scroll-margin-top: var(--header-h);
  }

  .project-explorer__header {
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--pad-x) 2rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .project-explorer__header .projects-kicker {
    margin-bottom: 0.9rem;
  }

  .project-explorer__header h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .project-explorer__header > p {
    max-width: 26rem;
    margin: 0;
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.7;
    text-align: right;
  }

  kbd {
    min-width: 1.35rem;
    padding: 0.1rem 0.35rem;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: var(--radius);
    color: var(--ink);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.3;
  }

  .project-toolbar {
    position: sticky;
    z-index: 50;
    top: calc(var(--header-h) - 1px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    border-block: 1px solid var(--line);
    background: var(--bg);
  }

  .project-search {
    min-height: 3.25rem;
    padding: 0 0.85rem 0 var(--pad-x);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-3);
    background: var(--panel);
    cursor: text;
  }

  .project-search:focus-within {
    color: var(--accent);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .project-search input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font-size: 0.9375rem;
  }

  .project-search input::placeholder {
    color: var(--ink-3);
  }

  .project-filters {
    display: flex;
    border-left: 1px solid var(--line);
  }

  .project-filters button {
    min-height: 3.25rem;
    padding: 0 1rem;
    border: 0;
    border-right: 1px solid var(--line);
    color: var(--ink-2);
    background: var(--bg);
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .project-filters button:last-child {
    border-right: 0;
  }

  .project-filters button:hover {
    color: var(--ink);
    background: var(--panel);
  }

  .project-filters button:focus-visible {
    outline-offset: -2px;
  }

  .project-filters button[aria-pressed="true"] {
    color: var(--bg);
    background: var(--ink);
  }

  .project-results-meta {
    min-height: 2.75rem;
    padding: 0 var(--pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1px;
  }

  .project-card {
    position: relative;
    min-height: 20rem;
    padding: 1.4rem var(--pad-x) 1.25rem;
    display: flex;
    flex-direction: column;
    transition: background-color 0.15s ease;
  }

  .project-card:hover {
    background: var(--panel);
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card.is-trending::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: 3rem;
    height: 2px;
    content: "";
    background: var(--accent);
  }

  .project-card__topline {
    min-height: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  .project-card__index {
    color: var(--accent);
  }

  .project-card__trending {
    padding: 0.1rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    border-radius: var(--radius);
    color: var(--accent);
    background: var(--accent-soft);
    font-size: 0.625rem;
    font-weight: 500;
  }

  .project-card h3 {
    margin: 1rem 0 0.7rem;
    font-size: 1.6rem;
    line-height: 1.12;
  }

  .project-card h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
  }

  .project-card h3 a:hover {
    color: var(--accent);
  }

  .project-card h3 :global(svg) {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-0.3rem);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .project-card:hover h3 :global(svg),
  .project-card h3 a:focus-visible :global(svg) {
    opacity: 1;
    transform: translateX(0);
  }

  .project-card > p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .project-card__highlight {
    margin-top: 0.9rem;
    padding-left: 0.6rem;
    border-left: 2px solid var(--warn);
    color: var(--warn);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .project-card__stack {
    margin: auto 0 0.95rem;
    padding: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
  }

  .project-card__stack li {
    padding: 0.12rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .project-card footer {
    position: relative;
    z-index: 1;
    padding-top: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .project-card footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.35rem 0.8rem;
  }

  .project-card footer a {
    min-height: 1.8rem;
    display: inline-flex;
    align-items: center;
    color: var(--ink-2);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0;
  }

  .project-card footer a:hover {
    color: var(--accent);
  }

  .project-card footer a:focus-visible {
    color: var(--accent);
  }

  .project-card footer a span {
    margin-left: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .project-empty {
    min-height: 18rem;
    padding: 3rem 1rem;
    place-items: center;
    align-content: center;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .project-empty:not([hidden]) {
    display: grid;
  }

  .project-empty > span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 2rem;
  }

  .project-empty h3 {
    margin: 0.5rem 0 0;
    font-size: 1.5rem;
  }

  .project-empty p,
  .project-noscript {
    margin: 0.35rem 0 0;
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  .project-noscript {
    padding: 1rem var(--pad-x);
  }

  @media (max-width: 64rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-toolbar {
      grid-template-columns: 1fr;
    }

    .project-filters {
      border-top: 1px solid var(--line);
      border-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .project-filters::-webkit-scrollbar {
      display: none;
    }

    .project-filters button {
      flex: none;
      min-height: 2.75rem;
    }
  }

  @media (max-width: 48rem) {
    .projects-hero {
      grid-template-columns: 1fr;
    }

    .projects-hero__copy {
      padding-top: 3.25rem;
    }

    .projects-hero h1 {
      font-size: clamp(2.3rem, 10vw, 3rem);
    }

    .projects-hero h1 em {
      font-size: 0.92em;
    }

    .projects-stats {
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      border-top: 1px solid var(--line);
      border-left: 0;
      background: var(--line);
    }

    .projects-stats::before,
    .projects-stats::after {
      display: none;
    }

    .projects-stats div,
    .projects-stats div:last-child {
      padding: 0.85rem 1rem;
      display: block;
      border: 0;
      background: var(--bg);
    }

    .projects-stats dt {
      min-height: 2.4em;
      font-size: 0.6875rem;
      line-height: 1.2;
    }

    .projects-stats dd {
      margin-top: 0.4rem;
      font-size: 1.5rem;
    }

    .project-explorer__header {
      align-items: start;
      flex-direction: column;
      gap: 0.9rem;
    }

    .project-explorer__header > p {
      text-align: left;
    }

    .project-toolbar {
      position: static;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card h3 :global(svg) {
      transition: none;
    }
  }
</style>
