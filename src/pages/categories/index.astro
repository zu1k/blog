---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterPostsByTaxonomy, formatDate, getCategories, getPostUrl, getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
const categories = getCategories(posts, 'count');
---

<BaseLayout title="所有分类" description="按领域浏览 zu1k 的文章。">
  <div class="wide-page categories-page">
    <PageHero
      eyebrow="TOPICS / COLLECTIONS"
      title="所有分类"
      description="把长期写作整理成一组可进入的主题书架。从编程与安全，到生活、经验和对当下的思考。"
      mark={categories.length}
      compact
    >
      <div slot="aside"><strong>{posts.length}</strong> 篇文章<br /><strong>{categories.length}</strong> 个持续主题</div>
    </PageHero>

    <section class="category-library band cells cells--open" aria-label="全部分类">
      {categories.map((term, index) => {
        const categoryPosts = filterPostsByTaxonomy(posts, 'categories', term.value);
        return (
          <article class="category-card">
            <header>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <b>{term.count} 篇</b>
            </header>
            <h2><a href={term.url}><Icon name="folder" size={20} /> {term.name}</a></h2>
            <ol>
              {categoryPosts.slice(0, 4).map((post) => (
                <li>
                  <a href={getPostUrl(post)}>{post.data.title}</a>
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, 'short').slice(5)}</time>
                </li>
              ))}
            </ol>
            <a class="category-card__more" href={term.url}>进入主题 <span aria-hidden="true">↗</span></a>
          </article>
        );
      })}
    </section>
  </div>
</BaseLayout>

<style>
  .categories-page :global(.page-hero__aside > div) {
    line-height: 2.6;
  }

  .categories-page :global(.page-hero__aside strong) {
    font-size: 1.75rem;
    line-height: 1;
  }

  .category-library {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .category-card {
    min-height: 15rem;
    padding: 1.5rem var(--pad-x) 1.35rem;
    display: flex;
    flex-direction: column;
    transition: background-color 0.15s ease;
  }

  .category-card:hover {
    background: var(--panel);
  }

  .category-card header {
    display: flex;
    justify-content: space-between;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  .category-card header span { color: var(--accent); }
  .category-card header b { font-weight: 400; }

  .category-card h2 {
    margin: 1rem 0 1.1rem;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .category-card h2 a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
  }

  .category-card h2 a:hover { color: var(--accent); }
  .category-card h2 :global(svg) { color: var(--accent); }

  .category-card ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .category-card li {
    min-width: 0;
    padding: 0.55rem 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .category-card li a {
    overflow: hidden;
    color: var(--ink-2);
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .category-card li a:hover { color: var(--accent); }

  .category-card time {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .category-card__more {
    margin-top: auto;
    padding-top: 1.1rem;
    display: flex;
    justify-content: space-between;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .category-card__more span {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  @media (max-width: 44rem) {
    .category-library { grid-template-columns: 1fr; }
    .category-card { min-height: 0; }
  }
</style>
