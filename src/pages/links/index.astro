---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import friends from '../../data/friends';
import { siteIdentity } from '../../data/identity';

const siteExchangeInfo = `NAME: ${siteIdentity.name}\nBIO: ${siteIdentity.description}\nURL: ${siteIdentity.url}\nLOGO: ${siteIdentity.logo}`;
---

<BaseLayout title="友情链接" description="友情链接，欢迎与我交换友链。">
  <div class="wide-page links-page">
    <PageHero
      eyebrow="PEERS / OPEN WEB"
      title="友邻网站"
      description="独立网站让互联网保留了人的气味。这些是我在开放网络里遇见，并愿意反复拜访的朋友与同行者。"
      mark={friends.length}
      compact
    >
      <div slot="aside" class="site-card">
        <span>本站信息</span>
        <img src="/images/logo.jpg" alt="" width="48" height="48" />
        <div>
          <strong>{siteIdentity.name}</strong>
          <code>{siteIdentity.url}</code>
        </div>
        <p>{siteIdentity.description}</p>
        <button type="button" data-copy-site-info={siteExchangeInfo}>复制站点信息</button>
      </div>
    </PageHero>

    <section class="friend-directory" aria-labelledby="friend-directory-title">
      <header>
        <div>
          <p>PEOPLE BEHIND THE LINKS</p>
          <h2 id="friend-directory-title">网络同行者</h2>
        </div>
        <span>{String(friends.length).padStart(2, '0')} FRIENDS</span>
      </header>

      <div class="friend-grid">
        {friends.map((friend, index) => (
          <a href={friend.url} rel="friend noopener" target="_blank">
            <span class="friend-index" data-no-select>{String(index + 1).padStart(2, '0')}</span>
            <img src={friend.avatar} alt="" width="96" height="96" loading="lazy" />
            <span class="friend-copy">
              <strong>{friend.name}</strong>
              <small>{friend.description}</small>
              <code>{new URL(friend.url).hostname}</code>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </section>

    <section class="exchange-note" aria-labelledby="exchange-title">
      <p>EXCHANGE / 交换友链</p>
      <h2 id="exchange-title">也欢迎你来敲门。</h2>
      <div>
        <p>如果你也在认真维护自己的独立网站，可以通过邮件发送网站名称、简介、地址与头像。</p>
        <a href="mailto:i@zu1k.com">i@zu1k.com <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const copySiteButton = document.querySelector<HTMLButtonElement>('[data-copy-site-info]');
  copySiteButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copySiteButton.dataset.copySiteInfo ?? '');
      copySiteButton.textContent = '已复制';
      setTimeout(() => { copySiteButton.textContent = '复制站点信息'; }, 1600);
    } catch {
      copySiteButton.textContent = '复制失败';
    }
  });
</script>

<style>
  .links-page :global(.page-hero__panel) {
    justify-content: flex-end;
  }

  .site-card {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem 0.7rem;
  }

  .site-card > span {
    grid-column: 1 / -1;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
  }

  .site-card img {
    width: 2.4rem;
    height: 2.4rem;
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    object-fit: cover;
  }

  .site-card > div { min-width: 0; display: flex; flex-direction: column; gap: 0.05rem; }

  .site-card strong {
    color: var(--ink);
    font-family: var(--font-display) !important;
    font-size: 1rem !important;
    font-weight: 600 !important;
  }

  .site-card code {
    overflow: hidden;
    color: var(--ink-2);
    font-family: var(--font-code);
    font-size: 0.52rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-card p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink-2);
    font-size: 0.6rem;
    line-height: 1.6;
  }

  .site-card button {
    grid-column: 1 / -1;
    height: 1.7rem;
    justify-self: start;
    padding: 0 0.6rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    color: var(--ink);
    background: transparent;
    font-family: var(--font-code);
    font-size: 0.52rem;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .site-card button:hover {
    color: var(--bg);
    background: var(--ink);
  }

  .friend-directory {
    padding: 2rem var(--pad) 2.4rem;
  }

  .friend-directory > header,
  .exchange-note {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .friend-directory > header {
    margin-bottom: 1.1rem;
  }

  .friend-directory > header p,
  .exchange-note > p {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-family: var(--font-code);
    font-size: 0.54rem;
    letter-spacing: 0.12em;
  }

  .friend-directory h2,
  .exchange-note h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .friend-directory > header > span {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
  }

  .links-page {
    padding-bottom: 0;
  }

  .friend-grid {
    padding: 1px 0 0 1px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .friend-grid a {
    position: relative;
    min-width: 0;
    min-height: 6.4rem;
    margin: -1px 0 0 -1px;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--line);
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.75rem;
    color: var(--ink);
    background: var(--panel);
    transition: background-color 0.15s ease;
  }

  .friend-grid a:hover {
    z-index: 1;
    border-color: var(--ink-3);
    background: var(--bg);
  }

  .friend-index {
    position: absolute;
    right: 0.7rem;
    bottom: 0.55rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.46rem;
    letter-spacing: 0.08em;
  }

  .friend-grid img {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(0.4);
    transition: filter 0.3s ease;
  }

  .friend-grid a:hover img {
    filter: none;
  }

  .friend-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .friend-copy strong {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-grid a:hover strong {
    color: var(--accent);
  }

  .friend-copy small {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-2);
    font-size: 0.58rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .friend-copy code {
    margin-top: 0.2rem;
    overflow: hidden;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.48rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-grid a > :global(.icon) {
    color: var(--ink-3);
    transform: rotate(-45deg);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .friend-grid a:hover > :global(.icon) {
    color: var(--accent);
    transform: rotate(-45deg) translateX(0.12rem);
  }

  .exchange-note {
    position: relative;
    padding: 2rem var(--pad) 2.6rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    border-top: 1px solid var(--line);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 1.2rem 1.2rem,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 1.2rem 1.2rem,
      var(--panel);
  }

  .exchange-note > p,
  .exchange-note h2 {
    grid-column: 1;
  }

  .exchange-note > div {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: end;
  }

  .exchange-note > div p {
    margin: 0 0 0.9rem;
    color: var(--ink-2);
    font-size: 0.7rem;
    line-height: 1.8;
  }

  .exchange-note > div a {
    min-height: 2.1rem;
    padding: 0 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--ink);
    border-radius: 2px;
    color: var(--bg);
    background: var(--ink);
    font-family: var(--font-code);
    font-size: 0.6rem;
  }

  .exchange-note > div a:hover {
    border-color: var(--accent);
    background: var(--accent);
  }

  :global(:root[data-theme="dark"]) .exchange-note > div a:hover {
    color: #0d1330;
  }

  @media (max-width: 60rem) {
    .site-card > span,
    .friend-directory > header p,
    .exchange-note > p,
    .friend-directory > header > span { font-size: 0.64rem; }
    .site-card code,
    .site-card button,
    .friend-index,
    .friend-copy code { font-size: 0.6rem; }
    .site-card p,
    .friend-copy small { font-size: 0.76rem; }
    .friend-copy strong { font-size: 1rem; }
    .exchange-note > div p { font-size: 0.9rem; }
    .exchange-note > div a { font-size: 0.72rem; }
    .friend-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 48rem) {
    .links-page :global(.page-hero__aside) {
      max-width: none;
      margin-top: 3.2rem;
    }

    .friend-directory {
      padding-top: 1.4rem;
    }

    .friend-grid {
      grid-template-columns: 1fr;
    }

    .exchange-note {
      grid-template-columns: 1fr;
    }

    .exchange-note > div {
      grid-column: 1;
      grid-row: auto;
      margin-top: 1rem;
    }
  }
</style>
