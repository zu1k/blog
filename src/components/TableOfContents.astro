---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 0 && (
  <aside class="article-toc" aria-label="文章目录" data-article-toc>
    <div class="article-toc__rail">
      <header>
        <span>ON THIS PAGE</span>
        <output aria-live="polite"><b data-toc-current>01</b> / {String(items.length).padStart(2, '0')}</output>
      </header>
      <nav data-toc aria-label="文章目录">
        <ol>
          {items.map((heading, index) => (
            <li class:list={{ 'is-subsection': heading.depth === 3 }}>
              <a href={`#${heading.slug}`} data-toc-index={index + 1}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <details class="article-toc__inline">
      <summary>
        <span>文章目录</span>
        <span class="article-toc__inline-status"><b data-toc-current>01</b> / {String(items.length).padStart(2, '0')}</span>
      </summary>
      <nav data-toc aria-label="文章目录">
        <ol>
          {items.map((heading, index) => (
            <li class:list={{ 'is-subsection': heading.depth === 3 }}>
              <a href={`#${heading.slug}`} data-toc-index={index + 1}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}

<script>
  const roots = [...document.querySelectorAll<HTMLElement>('[data-toc]')];
  const links = roots.flatMap((root) => [...root.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]);
  const sectionIds = [...new Set(links.map((link) => decodeURIComponent(link.hash.slice(1))))];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((node): node is HTMLElement => Boolean(node));
  const counters = [...document.querySelectorAll<HTMLElement>('[data-toc-current]')];

  const setActive = (id: string) => {
    const activeIndex = Math.max(0, sectionIds.indexOf(id));
    links.forEach((link) => {
      const active = decodeURIComponent(link.hash.slice(1)) === id;
      link.toggleAttribute('data-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    counters.forEach((counter) => {
      counter.textContent = String(activeIndex + 1).padStart(2, '0');
    });
  };

  let scheduled = false;
  const updateActiveSection = () => {
    scheduled = false;
    if (sections.length === 0) return;
    const readingLine = Math.min(window.innerHeight * 0.28, 220);
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= readingLine) current = section;
      else break;
    }
    setActive(current.id);
  };

  const scheduleUpdate = () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateActiveSection);
  };

  if (sections.length > 0) {
    updateActiveSection();
    addEventListener('scroll', scheduleUpdate, { passive: true });
    addEventListener('resize', scheduleUpdate, { passive: true });
  }

  links.forEach((link) => link.addEventListener('click', () => {
    const inline = link.closest('details');
    if (inline instanceof HTMLDetailsElement) inline.open = false;
  }));
</script>

<style>
  .article-toc {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .article-toc__rail {
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - var(--header-h) - 4rem);
  }

  .article-toc__rail header {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .article-toc__rail output {
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .article-toc__rail output b,
  .article-toc__inline-status b {
    color: var(--accent);
    font-weight: 500;
  }

  nav {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  ol {
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
    list-style: none;
  }

  li {
    position: relative;
    margin: 0;
  }

  a {
    position: relative;
    padding: 0.32rem 0 0.32rem 0.85rem;
    display: block;
    color: var(--ink-3);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  li.is-subsection a {
    padding-left: 1.6rem;
    font-size: 0.75rem;
  }

  a::before {
    position: absolute;
    top: 0.3rem;
    bottom: 0.3rem;
    left: -1px;
    width: 2px;
    content: "";
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0.4);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  a:hover {
    color: var(--ink);
  }

  a[data-active] {
    color: var(--ink);
    font-weight: 500;
  }

  a[data-active]::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .article-toc__inline {
    display: none;
  }

  @media (max-width: 64rem) {
    .article-toc {
      position: static;
    }

    .article-toc__rail {
      display: none;
    }

    .article-toc__inline {
      display: block;
      border: 1px solid var(--line-strong);
      background: var(--panel);
    }

    .article-toc__inline summary {
      min-height: 3rem;
      padding: 0 0.9rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      color: var(--ink);
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      list-style: none;
    }

    .article-toc__inline summary::-webkit-details-marker {
      display: none;
    }

    .article-toc__inline summary::after {
      width: 1.5rem;
      height: 1.5rem;
      display: grid;
      place-items: center;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      content: "+";
      color: var(--ink-2);
      background: var(--bg);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      font-weight: 400;
    }

    .article-toc__inline[open] summary {
      border-bottom: 1px solid var(--line);
    }

    .article-toc__inline[open] summary::after {
      content: "−";
    }

    .article-toc__inline-status {
      margin-left: auto;
      color: var(--ink-3);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 400;
      letter-spacing: 0.04em;
    }

    .article-toc__inline nav {
      max-height: min(22rem, 55vh);
      padding: 0.75rem 0.9rem 0.9rem;
    }

    .article-toc__inline a {
      padding-block: 0.4rem;
      font-size: 0.875rem;
    }

    .article-toc__inline li.is-subsection a {
      font-size: 0.8125rem;
    }
  }
</style>
