---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { PROJECTS, PROJECT_CATEGORY_LABELS, PROJECT_FILTERS } from '../../data/projects';

const trendingCount = PROJECTS.filter((project) => project.trending).length;
const categoryCount = new Set(PROJECTS.map((project) => project.category)).size;
---

<BaseLayout title="我的项目" description="zu1k 的开源项目、开发工具与技术实验。">
  <div class="frame projects-page" data-projects>
    <section class="projects-hero" aria-labelledby="projects-title">
      <div class="projects-hero__copy">
        <p class="projects-kicker" data-no-select><b>PROJECT INDEX</b> / 2017—NOW</p>
        <h1 id="projects-title" data-no-select>从一个问题，<br /><em>到一个可用的工具。</em></h1>
        <p class="projects-intro">
          我喜欢把真实遇到的问题做成小而锋利的工具。这里收录网络、系统、安全和开源生态中的长期作品与阶段性实验。
        </p>
        <div class="projects-actions" data-no-select>
          <a class="btn btn--primary" href="#project-explorer">
            浏览项目 <Icon name="arrow" size={15} />
          </a>
          <a class="btn" href="https://github.com/zu1k" rel="me noopener" target="_blank">
            <Icon name="github" size={15} /> GitHub
          </a>
        </div>
      </div>

      <dl class="projects-stats" aria-label="项目概览" data-no-select>
        <div>
          <dt>收录项目 / Projects</dt>
          <dd>{PROJECTS.length}<small>个</small></dd>
        </div>
        <div>
          <dt>GitHub Trending</dt>
          <dd>{trendingCount}<small>次</small></dd>
        </div>
        <div>
          <dt>探索领域 / Areas</dt>
          <dd>{categoryCount}<small>类</small></dd>
        </div>
      </dl>
    </section>

    <section class="project-explorer" id="project-explorer" aria-labelledby="project-explorer-title">
      <header class="project-explorer__header">
        <div>
          <p class="projects-kicker" data-no-select><b>01</b> / BROWSE THE WORK</p>
          <h2 id="project-explorer-title">项目浏览器</h2>
        </div>
        <p>按名称、技术或领域快速筛选。按 <kbd>/</kbd> 可以随时开始搜索。</p>
      </header>

      <div class="project-toolbar">
        <label class="project-search" for="project-search-input">
          <Icon name="search" size={18} />
          <span class="visually-hidden">搜索项目</span>
          <input
            id="project-search-input"
            type="search"
            placeholder="搜索项目、技术或关键词…"
            autocomplete="off"
            data-project-search
            data-slash-shortcut
          />
          <kbd aria-hidden="true">/</kbd>
        </label>

        <div class="project-filters" role="group" aria-label="项目类型">
          {PROJECT_FILTERS.map((filter, index) => (
            <button type="button" data-project-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {filter.label}
            </button>
          ))}
        </div>
      </div>

      <div class="project-results-meta">
        <output data-project-status aria-live="polite">显示全部 {PROJECTS.length} 个项目</output>
        <button type="button" data-project-clear hidden>清除筛选</button>
      </div>

      <div class="project-grid" data-project-grid>
        {PROJECTS.map((project, index) => {
          const primaryLink = project.links[0];
          const searchText = [
            project.name,
            project.summary,
            PROJECT_CATEGORY_LABELS[project.category],
            ...project.stack,
          ].join(' ').normalize('NFKC').toLocaleLowerCase('zh-CN');
          return (
            <article
              class:list={['project-card', { 'is-featured': project.featured, 'is-trending': project.trending }]}
              data-project-card
              data-category={project.category}
              data-trending={project.trending ? 'true' : 'false'}
              data-search={searchText}
            >
              <div class="project-card__topline">
                <span class="project-card__index" data-no-select>{String(index + 1).padStart(2, '0')}</span>
                {project.trending && <span class="project-card__trending">↗ GitHub Trending</span>}
              </div>

              <h3>
                <a
                  href={primaryLink.href}
                  target={primaryLink.href.startsWith('http') ? '_blank' : undefined}
                  rel={primaryLink.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {project.name}<Icon name="arrow" size={15} />
                </a>
              </h3>
              <p>{project.summary}</p>
              {project.highlight && <strong class="project-card__highlight">{project.highlight}</strong>}

              <ul class="project-card__stack" aria-label="技术标签">
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>

              <footer>
                <span>{PROJECT_CATEGORY_LABELS[project.category]}</span>
                <nav aria-label={`${project.name} 链接`}>
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target={link.href.startsWith('http') ? '_blank' : undefined}
                      rel={link.href.startsWith('http') ? 'noopener' : undefined}
                    >
                      {link.label}<span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </nav>
              </footer>
            </article>
          );
        })}
      </div>

      <div class="project-empty" data-project-empty hidden>
        <span aria-hidden="true">∅</span>
        <h3>没有匹配的项目</h3>
        <p>换一个关键词，或者清除当前筛选条件。</p>
      </div>
      <noscript><p class="project-noscript">筛选功能需要 JavaScript；当前已展示全部项目。</p></noscript>
    </section>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-projects]');
  const searchInput = root?.querySelector<HTMLInputElement>('[data-project-search]');
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-project-card]') ?? [])];
  const filters = [...(root?.querySelectorAll<HTMLButtonElement>('[data-project-filter]') ?? [])];
  const status = root?.querySelector<HTMLOutputElement>('[data-project-status]');
  const clearButton = root?.querySelector<HTMLButtonElement>('[data-project-clear]');
  const empty = root?.querySelector<HTMLElement>('[data-project-empty]');
  const availableFilters = new Set(filters.map((button) => button.dataset.projectFilter ?? ''));
  const params = new URLSearchParams(location.search);
  let activeFilter = availableFilters.has(params.get('filter') ?? '') ? params.get('filter')! : 'all';
  let query = params.get('q') ?? '';

  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('zh-CN').trim();

  const renderProjects = () => {
    const normalizedQuery = normalize(query);
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatch = activeFilter === 'all'
        || card.dataset.category === activeFilter
        || (activeFilter === 'trending' && card.dataset.trending === 'true');
      const queryMatch = !normalizedQuery || (card.dataset.search ?? '').includes(normalizedQuery);
      const visible = categoryMatch && queryMatch;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    filters.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === activeFilter));
    });

    if (status) {
      const qualifier = normalizedQuery ? `“${query.trim()}”` : filters.find((button) => button.dataset.projectFilter === activeFilter)?.textContent?.trim();
      status.textContent = activeFilter === 'all' && !normalizedQuery
        ? `显示全部 ${visibleCount} 个项目`
        : `${qualifier || '当前条件'} · ${visibleCount} 个结果`;
    }

    if (empty) empty.hidden = visibleCount !== 0;
    if (clearButton) clearButton.hidden = activeFilter === 'all' && !normalizedQuery;

    const nextUrl = new URL(location.href);
    activeFilter === 'all' ? nextUrl.searchParams.delete('filter') : nextUrl.searchParams.set('filter', activeFilter);
    normalizedQuery ? nextUrl.searchParams.set('q', query.trim()) : nextUrl.searchParams.delete('q');
    history.replaceState({}, '', nextUrl);
  };

  if (searchInput) searchInput.value = query;
  renderProjects();

  filters.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.projectFilter ?? 'all';
    renderProjects();
  }));

  searchInput?.addEventListener('input', () => {
    query = searchInput.value;
    renderProjects();
  });

  clearButton?.addEventListener('click', () => {
    activeFilter = 'all';
    query = '';
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    renderProjects();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement;
    if (event.key === '/' && !isTyping && !event.metaKey && !event.ctrlKey && !event.altKey) {
      event.preventDefault();
      searchInput?.focus();
    }
  });
</script>

<style>
  .projects-page {
    padding-bottom: 0;
  }

  /* Hero ------------------------------------------------------------------ */

  .projects-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.48fr);
    border-bottom: 1px solid var(--line);
  }

  .projects-hero__copy {
    min-width: 0;
    padding: clamp(2.6rem, 6vw, 4.2rem) var(--pad) 2.4rem;
  }

  .projects-kicker {
    margin: 0 0 1.1rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.56rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .projects-kicker b {
    color: var(--accent);
    font-weight: 500;
  }

  .projects-hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.2vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .projects-hero h1 em {
    color: var(--ink-2);
    font-style: italic;
    font-weight: 400;
  }

  .projects-intro {
    max-width: 32rem;
    margin: 1.3rem 0 0;
    color: var(--ink-2);
    font-size: 0.8rem;
    line-height: 1.85;
  }

  .projects-actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .projects-stats {
    min-width: 0;
    margin: 0;
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    border-left: 1px solid var(--line);
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 1.2rem 1.2rem,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 1.2rem 1.2rem,
      var(--panel);
  }

  .projects-stats div {
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-bottom: 1px solid var(--line);
  }

  .projects-stats div:last-child {
    border-bottom: 0;
  }

  .projects-stats dt {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .projects-stats dd {
    margin: 0.2rem 0 0;
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 2rem;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .projects-stats small {
    margin-left: 0.25rem;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 0.55rem;
    letter-spacing: 0;
  }

  /* Explorer -------------------------------------------------------------- */

  .project-explorer {
    padding: 2rem var(--pad) 3rem;
    scroll-margin-top: var(--header-h);
  }

  .project-explorer__header {
    margin-bottom: 1.2rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .project-explorer__header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .project-explorer__header .projects-kicker {
    margin-bottom: 0.5rem;
  }

  .project-explorer__header > p {
    max-width: 20rem;
    margin: 0;
    color: var(--ink-3);
    font-size: 0.62rem;
    line-height: 1.7;
    text-align: right;
  }

  .project-explorer__header kbd,
  .project-search kbd {
    min-width: 1rem;
    padding: 0 0.25rem;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-code);
    font-size: 0.52rem;
    line-height: 1.5;
  }

  .project-toolbar {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--panel);
  }

  .project-search {
    height: 2.4rem;
    padding: 0 0.6rem 0 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border-right: 1px solid var(--line-strong);
    color: var(--ink-3);
  }

  .project-search:focus-within {
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .project-search input {
    min-width: 0;
    height: 100%;
    flex: 1;
    border: 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font-family: var(--font-sans);
    font-size: 0.7rem;
  }

  .project-search input::-webkit-search-cancel-button {
    display: none;
  }

  .project-filters {
    min-width: 0;
    padding: 0.3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .project-filters button {
    height: 1.75rem;
    padding: 0 0.55rem;
    border: 1px solid transparent;
    border-radius: 2px;
    color: var(--ink-2);
    background: transparent;
    font-size: 0.6rem;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .project-filters button:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .project-filters button[aria-pressed="true"] {
    border-color: var(--ink);
    color: var(--bg);
    background: var(--ink);
  }

  .project-results-meta {
    min-height: 2.3rem;
    padding: 0.7rem 0 0.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.54rem;
    letter-spacing: 0.02em;
  }

  .project-results-meta button {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--ink-2);
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .project-results-meta button:hover {
    border-color: var(--ink);
    color: var(--bg);
    background: var(--ink);
  }

  .project-results-meta button[hidden] {
    display: none;
  }

  .project-grid {
    padding: 1px 0 0 1px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-card {
    --project-accent: var(--accent);
    position: relative;
    min-width: 0;
    min-height: 15rem;
    margin: -1px 0 0 -1px;
    padding: 0.95rem 1rem 0.9rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--panel);
    transition: background-color 0.15s ease;
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card:hover {
    z-index: 1;
    border-color: var(--ink-3);
    background: var(--bg);
  }

  .project-card.is-trending::before {
    position: absolute;
    top: -1px;
    right: -1px;
    left: -1px;
    height: 2px;
    content: "";
    background: var(--project-accent);
  }

  .project-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
  }

  .project-card__trending {
    padding: 0.05rem 0.35rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 2px;
    color: var(--accent);
    background: var(--accent-soft);
  }

  .project-card h3 {
    margin: 0.75rem 0 0.45rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .project-card h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .project-card h3 a :global(.icon) {
    color: var(--ink-3);
    transform: rotate(-45deg);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .project-card h3 a:hover {
    color: var(--accent);
  }

  .project-card h3 a:hover :global(.icon) {
    color: var(--accent);
    transform: rotate(-45deg) translateX(0.12rem);
  }

  .project-card > p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.64rem;
    line-height: 1.75;
  }

  .project-card__highlight {
    margin-top: 0.65rem;
    padding-left: 0.55rem;
    border-left: 2px solid var(--accent);
    color: var(--ink);
    font-size: 0.6rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .project-card__stack {
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
  }

  .project-card__stack li {
    padding: 0.02rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--ink-2);
    background: var(--bg);
    font-family: var(--font-code);
    font-size: 0.48rem;
  }

  .project-card footer {
    margin-top: auto;
    padding-top: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card footer > span {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
  }

  .project-card footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .project-card footer nav a {
    display: inline-flex;
    gap: 0.15rem;
    color: var(--ink);
    font-family: var(--font-code);
    font-size: 0.52rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .project-card footer nav a span {
    color: var(--ink-3);
  }

  .project-card footer nav a:hover,
  .project-card footer nav a:hover span {
    border-color: var(--accent);
    color: var(--accent);
  }

  .project-empty {
    padding: 3rem 1rem;
    border: 1px dashed var(--line-strong);
    color: var(--ink-2);
    text-align: center;
  }

  .project-empty[hidden] {
    display: none;
  }

  .project-empty > span {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 2rem;
  }

  .project-empty h3 {
    margin: 0.5rem 0 0.25rem;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .project-empty p {
    margin: 0;
    font-size: 0.64rem;
  }

  .project-noscript {
    color: var(--ink-3);
    font-family: var(--font-code);
    font-size: 0.56rem;
  }

  @media (max-width: 60rem) {
    .projects-kicker,
    .projects-stats dt,
    .project-results-meta,
    .project-card__topline,
    .project-card footer > span { font-size: 0.64rem; }
    .projects-intro,
    .project-search input { font-size: 0.95rem; }
    .project-explorer__header > p,
    .project-filters button,
    .project-empty p { font-size: 0.78rem; }
    .project-card > p { font-size: 0.86rem; }
    .project-card__highlight { font-size: 0.8rem; }
    .project-card__stack li,
    .project-card footer nav a { font-size: 0.62rem; }
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .project-toolbar { grid-template-columns: 1fr; }
    .project-search { border-right: 0; border-bottom: 1px solid var(--line-strong); }
  }

  @media (max-width: 48rem) {
    .projects-hero {
      grid-template-columns: 1fr;
    }

    .projects-hero__copy {
      padding: 2.4rem var(--pad) 1.8rem;
    }

    .projects-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: none;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .projects-stats div {
      padding: 0.8rem var(--pad);
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }

    .projects-stats div:last-child {
      border-right: 0;
    }

    .projects-stats dd {
      font-size: 1.5rem;
    }

    .project-explorer {
      padding-top: 1.4rem;
    }

    .project-explorer__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .project-explorer__header > p {
      text-align: left;
    }

    .project-filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .project-filters::-webkit-scrollbar {
      display: none;
    }

    .project-filters button {
      flex: none;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: 0;
    }
  }
</style>
